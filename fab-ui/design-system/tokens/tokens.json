{
  "$schema": "fab-ui design tokens v1 — single source for Fab OS surfaces (Plasma theme, colour schemes, apps, website)",
  "brand": { "name": "Fab OS", "vendor": "Patience AI", "mark": "ring with three woven bars, rotated -24°" },
  "color": {
    "semantic": {
      "dark":  { "background": "#0E1116", "surface": "#161B22", "surfaceElevated": "#1E242D", "surfaceOverlay": "rgba(14,17,22,0.82)",
                 "textPrimary": "#E6EAF0", "textSecondary": "#C9D1DC", "textMuted": "#9AA4B2", "border": "#2A313B",
                 "accent": "#6E9BFF", "accentStrong": "#3B6EF5", "success": "#3FCB7E", "warning": "#E0A64B", "danger": "#F0655D", "info": "#6E9BFF",
                 "focus": "#6E9BFF", "selection": "#3B6EF5" },
      "light": { "background": "#F6F7F9", "surface": "#FFFFFF", "surfaceElevated": "#EDEFF3", "surfaceOverlay": "rgba(246,247,249,0.86)",
                 "textPrimary": "#1B1F27", "textSecondary": "#3A4250", "textMuted": "#5B6472", "border": "#DDE1E8",
                 "accent": "#3B6EF5", "accentStrong": "#2F5FD8", "success": "#1F9D57", "warning": "#B7791F", "danger": "#C6362F", "info": "#3B6EF5",
                 "focus": "#3B6EF5", "selection": "#3B6EF5" }
    },
    "ai": { "local": "#3FCB7E", "cloud": "#6E9BFF", "blocked": "#F0655D", "pending": "#E0A64B" },
    "iconTiles": { "files": "#3B6EF5", "terminal": "#1E242D", "settings": "#5B6472", "software": "#1F9D57", "editor": "#B7791F", "browser": "#E0642B", "agent": "#6E9BFF", "feedback": "#7C5CFF" }
  },
  "typography": {
    "family": { "ui": "Inter", "mono": "JetBrains Mono" },
    "size": { "xs": 11, "sm": 13, "md": 14, "lg": 17, "xl": 22, "display": 34 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": 1.45
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48 },
  "radius": { "control": 10, "field": 12, "card": 16, "panel": 16, "popup": 18, "pill": 999, "iconTile": 16 },
  "border": { "hairline": 1, "focus": 1.5 },
  "elevation": { "flat": 0, "raised": 1, "overlay": 2, "modal": 3 },
  "shadow": { "raised": "0 4px 16px rgba(0,0,0,0.12)", "overlay": "0 12px 40px rgba(0,0,0,0.18)", "note": "Plasma/KWin draw shadows; app CSS only" },
  "opacity": { "panel": 0.93, "panelTranslucent": 0.74, "popup": 0.95, "popupTranslucent": 0.82, "disabled": 0.55 },
  "motion": {
    "duration": { "instant": 0, "fast": 120, "normal": 200, "slow": 320, "emphasis": 480 },
    "easing": { "standard": "cubic-bezier(.2,.7,.2,1)", "emphasized": "cubic-bezier(.2,.9,.1,1)", "accelerate": "cubic-bezier(.4,0,1,1)", "decelerate": "cubic-bezier(0,0,.2,1)" },
    "reducedMotion": "when the user enables Reduce Motion (Plasma AnimationDurationFactor=0), all durations collapse to instant"
  },
  "zIndex": { "desktop": 0, "panel": 10, "popup": 20, "notification": 30, "modal": 40, "lock": 100 },
  "focus": { "ring": "1.5px solid {color.focus}", "offset": 2 },
  "accessibility": { "minContrastText": 4.5, "minContrastLargeText": 3.0, "minTarget": 32, "nonColorIndicators": true }
}
