# syntax=docker/dockerfile:1
# FabOS OS rootfs recipe. Profiles: vm (QEMU test image, autologin) | iso (installer media, later).
ARG PROFILE=vm
ARG BASE=docker.io/library/ubuntu:26.04
# Build-time mirror (downloads only). The shipped OS is reset to the official archive at the end.
ARG MIRROR=http://archive.ubuntu.com/ubuntu

# ---------- stage 1: render brand assets (icons, splash frames, wallpapers, 3D) ----------
FROM ${BASE} AS assets
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pil fonts-inter fonts-jetbrains-mono librsvg2-bin ca-certificates && rm -rf /var/lib/apt/lists/*
COPY brand /src/brand
RUN python3 /src/brand/gen/make_assets.py --out /assets

# ---------- stage 2: build the FabOS .deb packages ----------
FROM ${BASE} AS pkgs
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends dpkg-dev python3 python3-pil xz-utils gpg ca-certificates wget && rm -rf /var/lib/apt/lists/*
COPY brand /src/brand
COPY packages /src/packages
# Mozilla's official apt signing key, shipped in fabos-branding so Firefox keeps updating from Mozilla (no snap). Fingerprint pinned.
RUN wget -qO /tmp/moz.asc https://packages.mozilla.org/apt/repo-signing-key.gpg && gpg --show-keys --with-fingerprint --with-colons /tmp/moz.asc | grep -q '^fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:' \
 && install -d /src/packages/fabos-branding/usr/share/keyrings && gpg --dearmor -o /src/packages/fabos-branding/usr/share/keyrings/packages.mozilla.org.gpg /tmp/moz.asc
COPY build/bin /src/bin
COPY --from=assets /assets /src/assets
RUN bash /src/packages/build-debs.sh /src /out

# ---------- stage 3: the operating system ----------
FROM ${BASE} AS rootfs
ARG PROFILE
ENV DEBIAN_FRONTEND=noninteractive LANG=en_US.UTF-8
# The container base is "minimized": undo the doc/man exclusion so new packages install complete.
# (Copyright files were never excluded; legal/UBUNTU-DERIVATIVE-COMPLIANCE.md #5.)
RUN rm -f /etc/dpkg/dpkg.cfg.d/excludes /etc/apt/apt.conf.d/docker-* && \
    printf 'Package: snapd ubuntu-pro-client ubuntu-advantage-tools ubuntu-report popularity-contest motd-news-config apport whoopsie\nPin: release *\nPin-Priority: -1\n' > /etc/apt/preferences.d/00-fabos-blocklist && \
    printf 'APT::Install-Recommends "true";\nAPT::Install-Suggests "false";\n' > /etc/apt/apt.conf.d/50fabos && \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv systemd-resolved systemd-timesyncd systemd-boot-efi udev dbus dbus-user-session polkitd kmod \
      initramfs-tools locales tzdata keyboard-configuration console-setup kbd sudo bash-completion \
      network-manager iproute2 iputils-ping ca-certificates curl wget less nano vim-tiny man-db \
      plymouth plymouth-label plymouth-themes apparmor apparmor-utils cryptsetup cryptsetup-initramfs \
      e2fsprogs dosfstools util-linux pciutils usbutils \
    && rm -rf /var/lib/apt/lists/*
# Kernel: Ubuntu's own, unmodified (Secure Boot stays intact on real hardware). vm = virtual flavour, no firmware blob.
RUN apt-get update && if [ "$PROFILE" = vm ]; then apt-get install -y --no-install-recommends linux-image-virtual; \
    else apt-get install -y linux-image-generic linux-firmware casper calamares grub-efi-amd64-signed shim-signed efibootmgr os-prober; fi && rm -rf /var/lib/apt/lists/*
# Switch to the build mirror for the big downloads (archive.ubuntu.com is unreliable from some regions).
# ARG is declared here, not at the top of the stage, so the base/kernel layers above stay cacheable.
ARG MIRROR
RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources
# Desktop (Plasma 6, Wayland) + apps. Recommends on so Plasma pulls what it needs; blocklist keeps snap/Pro out.
RUN apt-get update && apt-get install -y \
      plasma-desktop plasma-workspace kwin-wayland sddm plasma-nm plasma-pa pipewire wireplumber pipewire-pulse \
      konsole dolphin kate ark kde-spectacle plasma-systemmonitor kinfocenter plasma-discover plasma-discover-backend-flatpak flatpak \
      xdg-desktop-portal-kde kscreen powerdevil bluedevil breeze breeze-icon-theme breeze-gtk-theme kde-config-gtk-style \
      fonts-inter fonts-jetbrains-mono fonts-noto-core kwalletmanager okular gwenview kcalc \
      llama.cpp \
    && rm -rf /var/lib/apt/lists/*
# security.ubuntu.com is a separate line in ubuntu.sources; mirror it too (separate layer so the desktop layer above stays cached)
RUN sed -i "s|http://security.ubuntu.com/ubuntu|${MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources
# Firefox from Mozilla's apt repository (Ubuntu's own firefox package is a snap shim). Pinned above the Ubuntu archive.
COPY --from=pkgs /src/packages/fabos-branding/usr/share/keyrings/packages.mozilla.org.gpg /usr/share/keyrings/packages.mozilla.org.gpg
RUN printf 'Types: deb\nURIs: https://packages.mozilla.org/apt\nSuites: mozilla\nComponents: main\nSigned-By: /usr/share/keyrings/packages.mozilla.org.gpg\n' > /etc/apt/sources.list.d/mozilla.sources \
 && printf 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n' > /etc/apt/preferences.d/mozilla \
 && apt-get update && apt-get install -y firefox && rm -rf /var/lib/apt/lists/*
# Agent runtime deps (separate layer so the big desktop layer above stays cached)
RUN apt-get update && apt-get install -y python3-pyqt6 python3-anthropic python3-dbus python3-gi libnotify-bin wtype unattended-upgrades ubuntu-drivers-common && rm -rf /var/lib/apt/lists/*
# Bundled applications (own layer): LibreOffice with KDE integration, VLC, KWeather, extra Plasma widgets (weather, etc.)
RUN apt-get update && apt-get install -y libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-kf6 libreoffice-style-breeze hunspell-en-us vlc kweather plasma-widgets-addons && rm -rf /var/lib/apt/lists/*
# Low-RAM support (own layer, docs/LOW-RAM.md): compressed swap in RAM (systemd-zram-generator; fabos-desktop ships
# /etc/systemd/zram-generator.conf) and systemd-oomd, the Ubuntu Desktop default that the minimal container base lacks.
RUN apt-get update && apt-get install -y --no-install-recommends systemd-zram-generator systemd-oomd && rm -rf /var/lib/apt/lists/*
# FabOS packages (identity, desktop experience, AI stack)
COPY --from=pkgs /out/*.deb /tmp/debs/
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update && apt-get install -y /tmp/debs/fabos-branding_*.deb /tmp/debs/fabos-desktop_*.deb /tmp/debs/fabos-ai_*.deb /tmp/debs/fabos-agent_*.deb /tmp/debs/fabos-feedback_*.deb /tmp/debs/fabos-updates_*.deb /tmp/debs/fabos-firstboot_*.deb /tmp/debs/fabos-welcome_*.deb /tmp/debs/fabos-desktop-meta_*.deb \
    && apt-get install -y sddm-theme-breeze && (apt-get purge -y budgie-sddm-theme 2>/dev/null || true) && apt-get -y autoremove --purge && rm -rf /var/lib/apt/lists/* /tmp/debs
# System configuration
RUN sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/; s/^# *en_IN UTF-8/en_IN UTF-8/' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    ln -sf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && echo Asia/Kolkata > /etc/timezone && \
    printf 'LABEL=fabos-root  /         ext4  defaults,discard  0 1\nLABEL=FABOS-ESP   /boot/efi vfat  umask=0077        0 1\n' > /etc/fstab && mkdir -p /boot/efi && \
    systemctl enable NetworkManager systemd-resolved systemd-timesyncd sddm fabos-feedback.socket systemd-oomd.service && \
    truncate -s0 /etc/machine-id && rm -f /var/lib/dbus/machine-id && \
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
# Ship the official archive in the OS, not the build mirror
COPY image/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
COPY image/overlay/common/ /
# vm profile: test user with autologin, serial console, self-test service. NEVER ship this profile.
COPY image/overlay/${PROFILE}/ /
# The Ubuntu base image ships an 'ubuntu' account and the minimized-system MOTD; Fab OS has neither.
RUN (userdel -r ubuntu 2>/dev/null || true) && rm -f /etc/update-motd.d/60-unminimize /usr/local/sbin/unminimize
RUN if [ "$PROFILE" = vm ]; then \
      apt-get update && apt-get install -y --no-install-recommends openssh-server && rm -rf /var/lib/apt/lists/* && \
      useradd -m -s /bin/bash -G sudo,adm,video,audio,render,plugdev,netdev fabos && echo 'fabos:fabos' | chpasswd && \
      systemctl enable serial-getty@ttyS0 fabos-selftest ssh ; fi
RUN if [ "$PROFILE" = iso ]; then \
      install -d /etc/skel/Desktop && cp /usr/share/applications/fabos-install.desktop /etc/skel/Desktop/ && chmod +x /etc/skel/Desktop/fabos-install.desktop && \
      useradd -m -s /bin/bash -G sudo,adm,video,audio,render,plugdev,netdev,lpadmin fabos && passwd -d fabos && \
      printf '# live session (casper): no password for the live user\nfabos ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/fabos-live && chmod 0440 /etc/sudoers.d/fabos-live && \
      systemctl enable fabos-live-selftest serial-getty@ttyS0; fi
# Pre-fetch the archive index and the AppStream catalogue so Fab Software lists applications on the very first boot
# (official archive; tolerated failure — the daily apt timer and PackageKit refresh it later anyway).
RUN (apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update || true) && (appstreamcli refresh --force || true) && du -sh /var/lib/swcatalog /var/cache/swcatalog 2>/dev/null; rm -rf /var/lib/apt/lists/*   # keep the AppStream catalogue (~45 MB), drop the 175 MB package lists (PackageKit refreshes them on first use)
# Make sure the initramfs contains our Plymouth theme and the VM's drm driver, then record the kernel we ship.
RUN if [ "$PROFILE" = iso ]; then install -d /etc/calamares/branding/fabos && cp /usr/share/pixmaps/fabos.png /etc/calamares/branding/fabos/logo.png && cp /usr/share/pixmaps/fabos-logo-dark.png /etc/calamares/branding/fabos/wordmark.png \
 && cp /usr/share/wallpapers/FabOS/contents/images/1920x1080.png /etc/calamares/branding/fabos/slide.png && install -d /etc/skel/Desktop && cp /usr/share/applications/fabos-install.desktop /etc/skel/Desktop/ && chmod +x /etc/skel/Desktop/fabos-install.desktop; fi
RUN update-initramfs -u -k all && ls -la /boot && dpkg-query -W -f='${binary:Package}\t${Version}\n' > /usr/share/fabos/manifest.txt 2>/dev/null || (mkdir -p /usr/share/fabos && dpkg-query -W -f='${binary:Package}\t${Version}\n' > /usr/share/fabos/manifest.txt)
CMD ["/bin/bash"]
