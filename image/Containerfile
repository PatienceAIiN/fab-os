# syntax=docker/dockerfile:1
# FabOS OS rootfs recipe. Profiles: vm (QEMU test image, autologin) | iso (installer media, later).
ARG PROFILE=vm
ARG BASE=docker.io/library/ubuntu:26.04
# Build-time mirror (downloads only). The shipped OS is reset to the official archive at the end.
ARG MIRROR=http://archive.ubuntu.com/ubuntu

# ---------- stage 1: render brand assets (icons, splash frames, wallpapers, 3D) ----------
FROM ${BASE} AS assets
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pil fonts-inter fonts-jetbrains-mono librsvg2-bin ca-certificates && rm -rf /var/lib/apt/lists/*
COPY brand /src/brand
RUN python3 /src/brand/gen/make_assets.py --out /assets

# ---------- stage 2: build the FabOS .deb packages ----------
FROM ${BASE} AS pkgs
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends dpkg-dev python3 python3-pil xz-utils gpg ca-certificates wget && rm -rf /var/lib/apt/lists/*
COPY brand /src/brand
COPY packages /src/packages
# Mozilla's official apt signing key, shipped in fabos-branding so Firefox keeps updating from Mozilla (no snap). Fingerprint pinned
# (35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3, re-checked 2026-09-15 against https://packages.mozilla.org/apt/repo-signing-key.gpg):
# the build FAILS on any other key, so a key rotation is reviewed, never silently trusted (ADR-0018).
RUN wget -4 -qO /tmp/moz.asc https://packages.mozilla.org/apt/repo-signing-key.gpg && gpg --show-keys --with-fingerprint --with-colons /tmp/moz.asc | grep -q '^fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:' \
 && install -d /src/packages/fabos-branding/usr/share/keyrings && gpg --dearmor -o /src/packages/fabos-branding/usr/share/keyrings/packages.mozilla.org.gpg /tmp/moz.asc
COPY build/bin /src/bin
COPY --from=assets /assets /src/assets
RUN bash /src/packages/build-debs.sh /src /out

# ---------- stage 3: the operating system ----------
FROM ${BASE} AS rootfs
ARG PROFILE
ENV DEBIAN_FRONTEND=noninteractive LANG=en_US.UTF-8
# The container base is "minimized": undo the doc/man exclusion so new packages install complete.
# (Copyright files were never excluded; legal/UBUNTU-DERIVATIVE-COMPLIANCE.md #5.)
RUN rm -f /etc/dpkg/dpkg.cfg.d/excludes /etc/apt/apt.conf.d/docker-* && \
    printf 'Package: snapd ubuntu-pro-client ubuntu-advantage-tools ubuntu-report popularity-contest motd-news-config apport whoopsie kwalletmanager\nPin: release *\nPin-Priority: -1\n' > /etc/apt/preferences.d/00-fabos-blocklist && \
    printf 'APT::Install-Recommends "true";\nAPT::Install-Suggests "false";\n' > /etc/apt/apt.conf.d/50fabos && \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv systemd-resolved systemd-timesyncd systemd-boot-efi udev dbus dbus-user-session polkitd kmod \
      initramfs-tools locales tzdata keyboard-configuration console-setup kbd sudo bash-completion \
      network-manager iproute2 iputils-ping ca-certificates curl wget less nano vim-tiny man-db \
      plymouth plymouth-label plymouth-themes apparmor apparmor-utils cryptsetup cryptsetup-initramfs \
      e2fsprogs dosfstools util-linux pciutils usbutils \
    && rm -rf /var/lib/apt/lists/*
# Kernel: Ubuntu's own, unmodified (Secure Boot stays intact on real hardware). vm = virtual flavour, no firmware blob.
RUN apt-get update && if [ "$PROFILE" = vm ]; then apt-get install -y --no-install-recommends linux-image-virtual; \
    else apt-get install -y linux-image-generic linux-firmware casper calamares grub-efi-amd64-signed shim-signed efibootmgr os-prober; fi && rm -rf /var/lib/apt/lists/*
# Switch to the build mirror for the big downloads (archive.ubuntu.com is unreliable from some regions).
# ARG is declared here, not at the top of the stage, so the base/kernel layers above stay cacheable.
ARG MIRROR
RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources
# Desktop (Plasma 6, Wayland) + apps. Recommends on so Plasma pulls what it needs; blocklist keeps snap/Pro out.
RUN apt-get update && apt-get install -y \
      plasma-desktop plasma-workspace kwin-wayland kwin-style-aurorae sddm plasma-nm plasma-pa pipewire wireplumber pipewire-pulse \
      konsole dolphin kate ark kde-spectacle plasma-systemmonitor kinfocenter plasma-discover plasma-discover-backend-flatpak flatpak \
      xdg-desktop-portal-kde kscreen powerdevil bluedevil breeze breeze-icon-theme breeze-gtk-theme kde-config-gtk-style \
      fonts-inter fonts-jetbrains-mono fonts-noto-core okular gwenview kcalc \
      llama.cpp \
    && rm -rf /var/lib/apt/lists/*
# security.ubuntu.com is a separate line in ubuntu.sources; mirror it too (separate layer so the desktop layer above stays cached)
RUN sed -i "s|http://security.ubuntu.com/ubuntu|${MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources
# Firefox from Mozilla's own apt repository: Mozilla's unmodified official build, never patched or renamed by Fab OS (ADR-0018;
# another browser stood in for one release, ADR-0016). Ubuntu's own `firefox` package is a snap shim (1:1snap1) and snap is not installed,
# so the origin pin (packages.mozilla.org = 1000) puts Mozilla's build above the archive. `firefox` must NOT be listed in
# 00-fabos-blocklist above: a `Package: … firefox` record pins EVERY version of the name, Mozilla's included, to -1 (replayed in an
# Ubuntu 26.04 container on 2026-09-15: Candidate: (none) with the entry, 155.0.1~build1 without it). The build fails if the
# installed firefox is not Mozilla's, its desktop file or binary is missing, any source other than Ubuntu's and Mozilla's exists,
# anything of that browser's package set is left behind, `firefox` is still pinned out, or Firefox brought a setuid file (it has none: the image's setuid
# set is back to Ubuntu's stock set, tests/security/suid-baseline.txt). Mozilla's deb owns /usr/lib/firefox/distribution/ and its
# distribution.ini only; fabos-desktop adds policies.json there (Mozilla's documented enterprise-policy path) for a quiet first run.
# Firefox updates keep flowing from this repository through the normal apt update path (README "How updates work").
COPY --from=pkgs /src/packages/fabos-branding/usr/share/keyrings/packages.mozilla.org.gpg /usr/share/keyrings/packages.mozilla.org.gpg
RUN printf 'Types: deb\nURIs: https://packages.mozilla.org/apt\nSuites: mozilla\nComponents: main\nSigned-By: /usr/share/keyrings/packages.mozilla.org.gpg\n' > /etc/apt/sources.list.d/mozilla.sources \
 && printf 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n' > /etc/apt/preferences.d/mozilla \
 && apt-get update && apt-get install -y firefox && rm -rf /var/lib/apt/lists/* \
 && dpkg -s firefox | grep -q '^Maintainer: Mozilla' && test -f /usr/share/applications/firefox.desktop && test -x /usr/lib/firefox/firefox-bin \
 && test "$(ls /etc/apt/sources.list.d | grep -v -E '^(ubuntu|mozilla)\.sources$' | wc -l)" = 0 \
 && ! dpkg -s brave-browser >/dev/null 2>&1 && ! dpkg -s brave-keyring >/dev/null 2>&1 && test ! -e /opt/brave.com && test ! -e /etc/default/brave-browser \
 && ! grep -qw firefox /etc/apt/preferences.d/00-fabos-blocklist \
 && test -z "$(find /usr/lib/firefox -perm -4000 -type f)"
# Agent runtime deps (separate layer so the big desktop layer above stays cached)
RUN apt-get update && apt-get install -y python3-pyqt6 python3-anthropic python3-dbus python3-gi libnotify-bin wtype unattended-upgrades ubuntu-drivers-common && rm -rf /var/lib/apt/lists/*
# Bundled applications (own layer): LibreOffice with KDE integration, VLC, KWeather, extra Plasma widgets (weather, etc.)
# bubblewrap: the agent's run_shell sandbox (ADR-0017; Ubuntu's /etc/apparmor.d/bwrap-userns-restrict grants it user namespaces).
RUN apt-get update && apt-get install -y libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-kf6 libreoffice-style-breeze hunspell-en-us vlc kweather plasma-widgets-addons bubblewrap && rm -rf /var/lib/apt/lists/*
# Built-in local AI model (offline): Qwen2.5-1.5B-Instruct, GGUF Q4_K_M, 1 117 320 736 bytes, Apache-2.0 (Copyright 2024 Alibaba Cloud).
# Shipped inside BOTH profiles (vm + iso) so the agent works with no account and nothing to download; served on demand by
# fabos-llama.socket (package fabos-ai, ADR-0011). Pinned by byte count + sha256: the build FAILS on a short file or a mismatch.
# The same name/size/hash/URL live in packages/fabos-ai/usr/share/fabos/ai-models.json. Own layer before the FabOS packages so
# package rebuilds never refetch 1.1 GB. curl comes from the base layer above; Apache-2.0 text from base-files (common-licenses).
RUN set -e; d=/usr/share/fabos/models; f=qwen2.5-1.5b-instruct-q4_k_m.gguf; \
    u="https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/$f"; h=6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e; \
    install -d -m 0755 "$d" && curl -fL -sS --retry 3 --retry-delay 10 --retry-connrefused -o "$d/$f" "$u" \
 && [ "$(stat -c %s "$d/$f")" = 1117320736 ] && echo "$h  $d/$f" | sha256sum -c - && chmod 0644 "$d/$f" \
 && { printf 'Qwen2.5-1.5B-Instruct (GGUF, Q4_K_M) - the built-in offline model of Fab OS\n\nCopyright 2024 Alibaba Cloud\nLicensed under the Apache License, Version 2.0 (full text below).\nModel card: https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF\n\n'; cat /usr/share/common-licenses/Apache-2.0; } > "$d/LICENSE-qwen2.5" \
 && printf 'Name: Qwen2.5-1.5B-Instruct\nVersion: 2.5 (GGUF Q4_K_M, unmodified upstream file)\nFile: %s\nBytes: 1117320736\nSHA256: %s\nLicense: Apache-2.0, Copyright 2024 Alibaba Cloud (LICENSE-qwen2.5)\nSource: %s\nModel card: https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF\nServed by: fabos-llama.socket (user unit, 127.0.0.1:8080, loads on demand, unloads after 10 idle minutes)\nManifest: /usr/share/fabos/ai-models.json   Status: fabos-local-model status\n' "$d/$f" "$h" "$u" > "$d/README" \
 && ls -la "$d"

# Voice: offline wake word + speech-to-text + TTS
# pocketsphinx keyphrase spotting ("hey fab", en-us model from pocketsphinx-en-us) + whisper.cpp with the tiny.en model fetched HERE
# at build time and sha256-pinned (nothing is ever downloaded on the user's machine) + espeak-ng offline voice. Own layer, no
# dependency on the pkgs stage, so a package edit never re-downloads the 77 MB model.
RUN apt-get update && apt-get install -y whisper.cpp pocketsphinx pocketsphinx-en-us espeak-ng espeak-ng-data pipewire-bin pulseaudio-utils sox python3-numpy libnotify-bin \
 && install -d -m 0755 /usr/share/fabos/voice \
 && curl -fsSL --retry 3 --retry-delay 5 -o /usr/share/fabos/voice/ggml-tiny.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin \
 && echo '921e4cf8686fdd993dcd081a5da5b6c365bfde1162e72b08d75ac75289920b1f  /usr/share/fabos/voice/ggml-tiny.en.bin' | sha256sum -c - \
 && chmod 0644 /usr/share/fabos/voice/ggml-tiny.en.bin \
 && grep -q '^hey HH EY' /usr/share/pocketsphinx/model/en-us/cmudict-en-us.dict && grep -q '^fab F AE B' /usr/share/pocketsphinx/model/en-us/cmudict-en-us.dict \
 && rm -rf /var/lib/apt/lists/*
# (fabos-voice itself — CLI, "Hey Fab" listener, phrases — is installed with the other FabOS packages below; its postinst
#  enables the per-user unit for every user.)
# Low-RAM support (own layer, docs/LOW-RAM.md): compressed swap in RAM (systemd-zram-generator; fabos-desktop ships
# /etc/systemd/zram-generator.conf) and systemd-oomd, the Ubuntu Desktop default that the minimal container base lacks.
RUN apt-get update && apt-get install -y --no-install-recommends systemd-zram-generator systemd-oomd && rm -rf /var/lib/apt/lists/* && \
    (systemctl disable cups-browsed.service smartmontools.service motd-news.timer 2>/dev/null || true)
# Rounded window corners: KDE-Rounded-Corners effect built from source
# The Aurorae frame alone cannot round a window's four corners (a decoration only draws the title bar; the client's own
# bottom corners stayed square and the owner's device showed sharp edges), so the compositor does it: the KDE-Rounded-Corners
# KWin effect (GPL-3.0, github.com/matinlotfali/KDE-Rounded-Corners, release v0.10.0 of 2026-08-23; tarball URL + sha256
# pinned in image/rounded-corners-build.sh and repeated in the package's copyright file = the corresponding source,
# legal/SOURCE-OFFER.md) is compiled HERE against this image's exact kwin-dev (a KWin effect has no ABI stability across
# KWin minors), packaged as the Debian package fabos-rounded-corners (so the manifest, apt and dpkg list it: 165 kB effect
# plugin kwin4_effect_shapecorners.so, 289 kB KCM, two 23 kB shaders, six .mo files; .deb 135 kB) and installed. The
# build tools are then removed again — exactly the packages the step added, never a name list and never autoremove: a dry
# run in the finished round-3 image showed `apt-get purge qt6-base-dev-tools ...` cascading through plasma-workspace and
# fabos-desktop and a following autoremove taking 215 packages. The script fails loudly on a hash mismatch, a compile
# error, a missing file, a dangling library, a build tool left behind or any pre-existing package gone. It is bind-mounted,
# not COPYed, so nothing of it stays in the image. Measured 2026-09-15 by running this exact script in the round-3 image:
# +917 MB while the build tools are present (166 packages; 167 archives = 138 MB downloaded, 132 MiB on disk), 916 MB removed
# again, net +1 MB afterwards (7187 -> 7188 MB in /usr+/var+/etc; the package's Installed-Size is 592 kB). The fetched
# archives are deleted by listing /var/cache/apt/archives before vs after (apt stamps each .deb with the server's
# Last-Modified mtime, so `find -newer <marker>` deletes nothing); the 1656 archives of the earlier layers are left alone.
# One pre-existing package (perl-base) is upgraded by the dev install and stays so; the script lists such upgrades in the
# build log. /etc/xdg/kwinrc (fabos-desktop) switches it on:
# kwin4_effect_shapecornersEnabled=true, [Round-Corners] Size=14 = the Aurorae frame's own top radius (ADR-0019).
# Placed after the model and voice layers on purpose so their 1.2 GB of downloads stay cached across rebuilds.
COPY image/rounded-corners-build.sh /tmp/rounded-corners-build.sh
# (a plain COPY, not --mount=type=bind: on an SELinux host a bind-mounted file is unreadable inside podman build -> bash exit 126)
RUN bash /tmp/rounded-corners-build.sh && rm -f /tmp/rounded-corners-build.sh
# FabOS packages (identity, desktop experience, AI stack)
COPY --from=pkgs /out/*.deb /tmp/debs/
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update && apt-get install -y /tmp/debs/fabos-branding_*.deb /tmp/debs/fabos-desktop_*.deb /tmp/debs/fabos-ai_*.deb /tmp/debs/fabos-agent_*.deb /tmp/debs/fabos-feedback_*.deb /tmp/debs/fabos-updates_*.deb /tmp/debs/fabos-firstboot_*.deb /tmp/debs/fabos-welcome_*.deb /tmp/debs/fabos-voice_*.deb /tmp/debs/fabos-desktop-meta_*.deb \
    && apt-get install -y sddm-theme-breeze && (apt-get purge -y budgie-sddm-theme 2>/dev/null || true) && apt-get -y autoremove --purge && rm -rf /var/lib/apt/lists/* /tmp/debs
# System configuration. No wallet (ADR-0015): pam_kwallet5 is dropped from the SDDM PAM stack (both lines are `optional`, so
# login is unchanged) so no kwalletd6 is spawned at login; the build asserts /etc/xdg/kwalletrc says Enabled=false and that
# kwalletmanager is absent (ksshaskpass and libqt6keychain1 Recommend it, hence the -1 pin in 00-fabos-blocklist above).
# Firewall on by default (ufw: deny incoming, allow outgoing, no rules — the ISO ships no SSH server).
# `ufw enable` cannot run here (no netfilter in the build container), so persist exactly what it would write: the policies
# in /etc/default/ufw, ENABLED=yes in /etc/ufw/ufw.conf (ufw-init loads the rules at boot only when this is yes) and ufw.service.
# Enterprise hardening (ADR-0017, docs/ENTERPRISE.md, asserted by tests/security-check.sh):
#  - mDNS off: avahi-daemon (service + socket) disabled — a discovery surface nothing in the image needs (no KDE Connect, no
#    cups-browsed); re-enable with `systemctl enable --now avahi-daemon.socket avahi-daemon.service`.
#  - the three Fab OS AppArmor profiles (fabos-llama enforce; fabos-voiced + fabos-agentd complain until a VM run under an
#    AppArmor kernel shows no denials — ADR-0017 amendment 9) must parse with the
#    image's own apparmor_parser (-Q -K: compile only; the build container has no AppArmor interface), and the kernel
#    hardening sysctl file must be in place; the polkit action for the agent's root path must be well-formed XML.
#  - no NOPASSWD rule may exist in sudoers (the fabos-live rule of the iso profile is written later and deleted by the installer).
#  - unattended-upgrades stays enabled with Ubuntu security + the Fab OS origins (fabos-updates ships 52fabos-unattended).
RUN sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/; s/^# *en_IN UTF-8/en_IN UTF-8/' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    systemctl disable avahi-daemon.service avahi-daemon.socket && \
    test -f /etc/sysctl.d/70-fabos-hardening.conf && grep -q '^net.core.bpf_jit_harden = 2' /etc/sysctl.d/70-fabos-hardening.conf && \
    apparmor_parser -Q -K /etc/apparmor.d/fabos-agentd /etc/apparmor.d/fabos-voiced /etc/apparmor.d/fabos-llama && \
    python3 -c "import xml.etree.ElementTree as E; a=E.parse('/usr/share/polkit-1/actions/in.patienceai.fabos.rootexec.policy').getroot().find('action'); assert {d.tag: d.text for d in a.find('defaults')} == {'allow_any': 'no', 'allow_inactive': 'no', 'allow_active': 'auth_admin_keep'}" && \
    ! test -e /etc/sudoers.d/fabos-agent && ! grep -rqE '^[^#]*NOPASSWD' /etc/sudoers.d /etc/sudoers && visudo -cqf /etc/sudoers.d/fabos-hardening && \
    test -x /usr/bin/bwrap && test -u /usr/bin/pkexec && test -x /usr/lib/polkit-1/polkitd && \
    systemctl is-enabled unattended-upgrades && grep -q 'APT::Periodic::Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades && grep -q -- '-security' /etc/apt/apt.conf.d/52fabos-unattended && \
    grep -q '^Autolock=true' /etc/xdg/kscreenlockerrc && grep -q '^LidAction=1' /etc/xdg/powerdevilrc && \
    ln -sf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && echo Asia/Kolkata > /etc/timezone && \
    printf 'LABEL=fabos-root  /         ext4  defaults,discard  0 1\nLABEL=FABOS-ESP   /boot/efi vfat  umask=0077        0 1\n' > /etc/fstab && mkdir -p /boot/efi && \
    systemctl enable NetworkManager systemd-resolved systemd-timesyncd sddm fabos-feedback.socket systemd-oomd.service && \
    sed -i '/pam_kwallet5\.so/d' /etc/pam.d/sddm && ! grep -q pam_kwallet /etc/pam.d/sddm && \
    grep -q '^Enabled=false$' /etc/xdg/kwalletrc && ! dpkg -s kwalletmanager >/dev/null 2>&1 && \
    ufw default deny incoming && ufw default allow outgoing && \
    sed -i 's/^ENABLED=no$/ENABLED=yes/' /etc/ufw/ufw.conf && grep -q '^ENABLED=yes$' /etc/ufw/ufw.conf && systemctl enable ufw && \
    truncate -s0 /etc/machine-id && rm -f /var/lib/dbus/machine-id && \
    ( flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || echo 'flathub remote not added (offline build?) - continuing' )
# ^ the Flatpak fallback is grouped on purpose: a bare trailing '|| true' would swallow a failure ANYWHERE in this && chain
#   (it did once: a comment containing the word NOPASSWD tripped the assertion above and every later command was skipped).
# Ship the official archive in the OS, not the build mirror
COPY image/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources
COPY image/overlay/common/ /
# vm profile: test user with autologin, serial console, self-test service. NEVER ship this profile.
COPY image/overlay/${PROFILE}/ /
# The Ubuntu base image ships an 'ubuntu' account and the minimized-system MOTD; Fab OS has neither.
RUN (userdel -r ubuntu 2>/dev/null || true) && rm -f /etc/update-motd.d/60-unminimize /usr/local/sbin/unminimize
RUN if [ "$PROFILE" = vm ]; then \
      apt-get update && apt-get install -y --no-install-recommends openssh-server && rm -rf /var/lib/apt/lists/* && \
      useradd -m -s /bin/bash -G sudo,adm,video,audio,render,plugdev,netdev fabos && echo 'fabos:fabos' | chpasswd && \
      sed -i 's/^ENABLED=yes$/ENABLED=no/' /etc/ufw/ufw.conf && ufw allow 22/tcp && sed -i 's/^ENABLED=no$/ENABLED=yes/' /etc/ufw/ufw.conf && grep -q '^ENABLED=yes$' /etc/ufw/ufw.conf && \
      grep -q '^-A ufw-user-input -p tcp --dport 22 -j ACCEPT' /etc/ufw/user.rules && systemctl enable serial-getty@ttyS0 fabos-selftest ssh ; fi
# ^ vm only: SSH for the QEMU harness (hostfwd 2222->22) through the firewall. `ufw allow` refuses to write rules while
#   ENABLED=yes and netfilter is unreachable (initcaps() is a hard error, exit 1), so the flag is lowered for the one rule
#   write and raised again; the grep proves the rule landed. The iso profile adds no rules (branding-check asserts zero).
RUN if [ "$PROFILE" = iso ]; then \
      install -d /etc/skel/Desktop && cp /usr/share/applications/fabos-install.desktop /etc/skel/Desktop/ && chmod +x /etc/skel/Desktop/fabos-install.desktop && \
      useradd -m -s /bin/bash -G sudo,adm,video,audio,render,plugdev,netdev,lpadmin fabos && passwd -d fabos && \
      printf '# live session (casper): no password for the live user\nfabos ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/fabos-live && chmod 0440 /etc/sudoers.d/fabos-live && \
      systemctl enable fabos-live-selftest serial-getty@ttyS0; fi
# Pre-fetch the archive index and the AppStream catalogue so Fab Software lists applications on the very first boot
# (official archive; tolerated failure — the daily apt timer and PackageKit refresh it later anyway).
RUN (apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=3 update || true) && (appstreamcli refresh --force || true) && du -sh /var/lib/swcatalog /var/cache/swcatalog 2>/dev/null; rm -rf /var/lib/apt/lists/*   # keep the AppStream catalogue (~45 MB), drop the 175 MB package lists (PackageKit refreshes them on first use)
# Make sure the initramfs contains our Plymouth theme and the VM's drm driver, then record the kernel we ship.
RUN if [ "$PROFILE" = iso ]; then install -d /etc/calamares/branding/fabos && cp /usr/share/pixmaps/fabos.png /etc/calamares/branding/fabos/logo.png && cp /usr/share/pixmaps/fabos-logo-dark.png /etc/calamares/branding/fabos/wordmark.png \
 && cp /usr/share/wallpapers/FabOS/contents/images/1920x1080.png /etc/calamares/branding/fabos/slide.png && install -d /etc/skel/Desktop && cp /usr/share/applications/fabos-install.desktop /etc/skel/Desktop/ && chmod +x /etc/skel/Desktop/fabos-install.desktop; fi
RUN update-initramfs -u -k all && ls -la /boot && dpkg-query -W -f='${binary:Package}\t${Version}\n' > /usr/share/fabos/manifest.txt 2>/dev/null || (mkdir -p /usr/share/fabos && dpkg-query -W -f='${binary:Package}\t${Version}\n' > /usr/share/fabos/manifest.txt)
CMD ["/bin/bash"]
