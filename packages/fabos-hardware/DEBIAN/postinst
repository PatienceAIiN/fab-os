#!/bin/sh
# fabos-hardware: fingerprint sign-in, camera stack and Fab Camera naming. Idempotent; never fails an upgrade
# (an update installed in the background by unattended-upgrades must never leave apt half-configured).
set -e
case "$1" in configure)
  # 1. Fingerprint authentication for every PAM service that includes common-auth (SDDM login, the lock screen, sudo,
  #    polkit prompts): the pam-auth-update profile "fprintd" that libpam-fprintd ships (Default: yes, so libpam-fprintd's
  #    own postinst normally enables it; this covers a system where it was switched off before this package arrived).
  #    Non-interactive: --package never asks. The "unix" (password) profile stays on: a fingerprint is always an
  #    alternative, never the only way in (docs/HARDWARE.md).
  if [ -f /usr/share/pam-configs/fprintd ] && ! grep -qs pam_fprintd /etc/pam.d/common-auth; then
    DEBIAN_FRONTEND=noninteractive pam-auth-update --package --enable fprintd 2>/dev/null || true
  fi
  if ! grep -qs pam_unix /etc/pam.d/common-auth; then
    DEBIAN_FRONTEND=noninteractive pam-auth-update --package --enable unix 2>/dev/null || true
  fi
  # 2. fprintd is D-Bus activated (net.reactivated.Fprint) and libfprint's udev/hwdb rules were installed by their own
  #    packages; nothing to enable. Refresh the hwdb index so a reader plugged in from now on gets its autosuspend rule.
  if [ -d /run/udev ] && command -v systemd-hwdb >/dev/null 2>&1; then systemd-hwdb update 2>/dev/null || true; fi
  # 3. Fab Camera: the Fab OS name of the camera app (rule in /usr/lib/fabos/overrides.d/hardware.rules, copy written to
  #    /usr/share/fabos/applications by fabos-branding's generator, which the session reads first).
  [ -x /usr/lib/fabos/rebrand-overrides ] && /usr/lib/fabos/rebrand-overrides || true
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q 2>/dev/null || true
;; esac
exit 0
