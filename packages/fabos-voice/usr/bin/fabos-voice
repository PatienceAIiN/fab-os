#!/usr/bin/env python3
"""fabos-voice — talk to Fab OS from the command line (the VOICE CONTRACT every Fab OS UI calls).

  fabos-voice listen-once [--timeout SECONDS]   chime, record until ~1.2 s of silence (or the timeout, default 10 s),
                                                print the recognised text; exit 3 = nothing heard, 4 = no speech-to-text
  fabos-voice say TEXT...                       speak TEXT (blocking); exit 4 = no text-to-speech
  fabos-voice status                            one JSON line: {"wake","listening","stt","tts","mic"}
  fabos-voice wake on|off                       turn the always-on "Hey Fab" listener on or off (voice.enabled)
  fabos-voice chime                             play the listening chime (diagnostic)

Speech-to-text: the agent's cloud endpoint when a cloud speech provider is configured and voice.offline_only is off,
otherwise whisper.cpp with the tiny.en model shipped in /usr/share/fabos/voice. Text-to-speech: the agent's cloud
voice (Indian English) when available, otherwise espeak-ng (a plain British-English voice, offline).
"""
import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for _cand in (os.path.join(HERE, "..", "lib", "fabos", "voice"), "/usr/lib/fabos/voice"):
    if os.path.isfile(os.path.join(_cand, "voicelib.py")):
        sys.path.insert(0, os.path.normpath(_cand))
        break
import phrases as P  # noqa: E402
import voicelib as V  # noqa: E402


def cmd_listen_once(a):
    agent = V.Agent()
    try:
        text, backend = V.listen_once(a.timeout, agent)
    except V.NothingHeard:
        print(P.NOT_HEARD, file=sys.stderr)
        return V.EXIT_NOTHING_HEARD
    except V.NoBackend as e:
        print(str(e) or P.NO_STT, file=sys.stderr)
        return V.EXIT_NO_BACKEND
    print(text)
    if a.verbose:
        print("backend: " + backend, file=sys.stderr)
    return V.EXIT_OK


def cmd_say(a):
    text = " ".join(a.text).strip()
    if not text:
        return V.EXIT_OK
    try:
        backend = V.speak(text, V.Agent())
    except V.NoBackend as e:
        print(str(e) or P.NO_TTS, file=sys.stderr)
        return V.EXIT_NO_BACKEND
    if a.verbose:
        print("backend: " + backend, file=sys.stderr)
    return V.EXIT_OK


def cmd_status(a):
    st = V.status(V.Agent())
    if not a.verbose:
        st = {k: st[k] for k in ("wake", "listening", "stt", "tts", "mic")}
    print(json.dumps(st))
    return V.EXIT_OK


def cmd_wake(a):
    agent = V.Agent()
    on = a.state == "on"
    try:
        r = agent.put("/settings", {"voice.enabled": "true" if on else "false"})
    except V.NoBackend as e:
        print(str(e) or P.AGENT_DOWN, file=sys.stderr)
        return V.EXIT_NO_BACKEND
    if not (isinstance(r, dict) and r.get("ok")):
        print("could not save the setting: %s" % r, file=sys.stderr)
        return 1
    if on:
        # make sure the listener service is running; harmless when it already is or when systemd is absent
        try:
            subprocess.run(["systemctl", "--user", "start", "fabos-voiced.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except Exception:
            pass
    print(P.WAKE_ON if on else P.WAKE_OFF)
    return V.EXIT_OK


def cmd_chime(a):
    return V.EXIT_OK if V.play_chime() else V.EXIT_NO_BACKEND


def main(argv=None):
    ap = argparse.ArgumentParser(prog="fabos-voice", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-v", "--verbose", action="store_true", help="print which backend was used on stderr")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("listen-once", help="record one utterance and print the text")
    p.add_argument("--timeout", type=float, default=V.DEFAULT_TIMEOUT_S, help="hard cap in seconds (default 10)")
    p.set_defaults(fn=cmd_listen_once)
    p = sub.add_parser("say", help="speak text")
    p.add_argument("text", nargs="+")
    p.set_defaults(fn=cmd_say)
    p = sub.add_parser("status", help="print the voice status as one JSON line")
    p.set_defaults(fn=cmd_status)
    p = sub.add_parser("wake", help="turn the 'Hey Fab' listener on or off")
    p.add_argument("state", choices=["on", "off"])
    p.set_defaults(fn=cmd_wake)
    p = sub.add_parser("chime", help="play the listening chime")
    p.set_defaults(fn=cmd_chime)
    a = ap.parse_args(argv)
    if not a.cmd:
        ap.print_help()
        return 0
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
