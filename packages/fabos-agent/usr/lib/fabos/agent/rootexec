#!/usr/bin/env python3
"""fabos rootexec — the agent's only path to root.

Invoked as `pkexec /usr/lib/fabos/agent/rootexec <authz-id>` under the polkit action in.patienceai.fabos.rootexec
(/usr/share/polkit-1/actions/in.patienceai.fabos.rootexec.policy: allow_any=no, allow_inactive=no,
allow_active=auth_admin_keep). polkit therefore asks the user for THEIR OWN password in the system dialog (an
administrator's password for a non-admin account) before this program ever runs, in every agent mode — bypass included —
and remembers it for five minutes. Fab OS ships no sudoers rule for this program any more (ADR-0017).

Even then it executes a command as root ONLY if the calling user's own agent daemon wrote an authorization record for it:
  /run/user/<uid>/fabos-agent/authz/<authz-id>.json
    {"id": <authz-id>, "command": ..., "command_sha256": sha256(command), "cwd": ..., "timeout_s": ..., "task_id": ..., "uid": <uid>}
The record and its directory must be owned by the invoking user (PKEXEC_UID) and private (no group/other bits), the
record must not be a symlink, must be younger than ten minutes, must carry this very authz-id and a sha256 that matches
its command (a record whose command differs from what was approved is refused), and it is deleted before anything runs
(single use). Every decision is written to the audit log: syslog (authpriv) and /var/log/fabos/rootexec.log (root:adm 0640);
the daemon records the same step in its own HMAC-chained activity log.

Output: one JSON line on stdout — {exit_code, stdout, stderr} or {"error": reason} (exit 2)."""
import hashlib, json, os, stat, subprocess, sys, syslog, time

MAX_AGE_S = 600
RUN_BASE = "/run/user"
LOG_DIR = "/var/log/fabos"
AUDIT = True             # tests switch the audit sinks off


def fail(msg, code=2):
    print(json.dumps({"error": msg}))
    return code


def caller_uid(env):
    """The invoking user's uid as set by the setuid launcher (pkexec sets PKEXEC_UID; an administrator's own sudo rule
    would set SUDO_UID). Both scrub the environment, so a caller cannot forge these unless it is already root."""
    for var in ("PKEXEC_UID", "SUDO_UID"):
        v = env.get(var)
        if v and v.isdigit():
            return int(v), var
    return None, None


def audit(line):
    if not AUDIT:
        return
    try:
        syslog.openlog("fabos-rootexec", 0, syslog.LOG_AUTHPRIV)
        syslog.syslog(syslog.LOG_NOTICE, line)
    except Exception:
        pass
    try:
        os.makedirs(LOG_DIR, mode=0o750, exist_ok=True)
        fd = os.open(os.path.join(LOG_DIR, "rootexec.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o640)
        with os.fdopen(fd, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z") + " " + line + "\n")
    except OSError:
        pass


def load_record(uid, aid, run_base, now):
    """Validate, then consume, the authorization record. Returns (record, None) or (None, reason)."""
    d = os.path.join(run_base, str(uid), "fabos-agent", "authz")
    try:
        dst = os.lstat(d)
    except FileNotFoundError:
        return None, "no authorization record for this action"
    if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != uid or dst.st_mode & 0o077:
        return None, "authorization directory must be owned by the caller and private (0700)"
    path = os.path.join(d, aid + ".json")
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None, "no authorization record for this action"
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_mode & 0o077:
        return None, "authorization record not owned by caller or not private"
    if now - st.st_mtime > MAX_AGE_S or st.st_mtime - now > 60:
        os.remove(path)
        return None, "authorization expired"
    try:
        with open(path) as f:
            rec = json.load(f)
    except (OSError, ValueError):
        rec = None
    try:
        os.remove(path)                      # single use, whatever happens next
    except FileNotFoundError:
        pass
    if not isinstance(rec, dict):
        return None, "authorization record unreadable"
    if rec.get("id") != aid:
        return None, "authorization record does not belong to this action"
    cmd = rec.get("command")
    if not isinstance(cmd, str) or not cmd.strip():
        return None, "empty command"
    if rec.get("command_sha256") != hashlib.sha256(cmd.encode()).hexdigest():
        return None, "command differs from what was approved"
    if rec.get("uid") not in (None, uid):
        return None, "authorization record was written for another user"
    return rec, None


def main(argv, env, run_base=RUN_BASE, euid=None, now=None):
    euid = os.geteuid() if euid is None else euid
    now = time.time() if now is None else now
    if len(argv) != 2 or not argv[1].isalnum() or len(argv[1]) > 64:
        return fail("usage: rootexec <authz-id>")
    aid = argv[1]
    uid, via = caller_uid(env)
    if uid is None or euid != 0:
        return fail("must be run through pkexec (polkit action in.patienceai.fabos.rootexec)")
    if uid == 0:
        return fail("refusing: the caller is root already")
    rec, why = load_record(uid, aid, run_base, now)
    if rec is None:
        audit("REFUSED uid=%d id=%s via=%s reason=%s" % (uid, aid, via, why))
        return fail(why)
    cmd = rec["command"]
    digest = rec["command_sha256"]
    cwd = rec.get("cwd") if isinstance(rec.get("cwd"), str) and rec.get("cwd", "").startswith("/") and os.path.isdir(rec.get("cwd")) else "/"
    try:
        timeout = min(int(rec.get("timeout_s") or 300), 3600)
    except (TypeError, ValueError):
        timeout = 300
    run_env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "LANG": "C.UTF-8", "DEBIAN_FRONTEND": "noninteractive",
               "FABOS_AGENT_ROOT_TASK": str(rec.get("task_id", "")), "FABOS_ROOTEXEC_UID": str(uid)}
    audit("RUN uid=%d id=%s via=%s task=%s sha256=%s cwd=%s" % (uid, aid, via, rec.get("task_id", ""), digest[:16], cwd))
    try:
        r = subprocess.run(["bash", "-lc", cmd], cwd=cwd, capture_output=True, text=True, timeout=timeout, env=run_env, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        audit("TIMEOUT uid=%d id=%s after %ds" % (uid, aid, timeout))
        print(json.dumps({"error": "timeout"}))
        return 0
    audit("DONE uid=%d id=%s exit=%d" % (uid, aid, r.returncode))
    print(json.dumps({"exit_code": r.returncode, "stdout": r.stdout[-30000:], "stderr": r.stderr[-10000:]}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv, os.environ))
