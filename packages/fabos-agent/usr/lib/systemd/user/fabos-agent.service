[Unit]
Description=@DISTRO_NAME@ autonomous agent service
Documentation=@DOCS_URL@
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/fabos/agent/fabos_agentd.py
Restart=on-failure
RestartSec=2
EnvironmentFile=-/etc/fabos/agent.env
EnvironmentFile=-%h/.config/fabos/agent.env
# The agent must act as the user in their session (open apps, type, run commands), so it is
# deliberately NOT sandboxed here; authority is bounded by the deterministic policy + approvals.

[Install]
WantedBy=default.target
