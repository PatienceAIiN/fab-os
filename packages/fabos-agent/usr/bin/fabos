#!/usr/bin/env python3
"""fabos — command-line client for the Fab OS agent (fabos-agentd).

  fabos do "open editor, write hi and mail it to x@y"   start a task (agent works autonomously)
  fabos do --follow-up ID "and now ..."                 continue an existing chat (threads the new task under task ID)
  fabos tasks | show ID | cancel ID | retry ID | delete ID | edit ID --title T --request R
  fabos approvals | approve APPROVAL_ID | deny APPROVAL_ID | answer TASK_ID "text"
  fabos mode [ask|auto|bypass]      permission mode (ask: approve MEDIUM+, auto: approve CRITICAL only, bypass: never ask)
  fabos settings [KEY VALUE]         e.g. fabos settings provider openai ; fabos settings mail.provider gmail ; fabos settings mail.address me@gmail.com
                                     (an empty VALUE unsets a key: fabos settings mail.provider '' infers the provider from the address again)
  fabos set-key claude|gemini|openai|deepseek|local|ollama|mail   store a secret (prompted, never echoed; mail = the app password;
                                     ollama = only for a reverse-proxied remote Ollama that wants a bearer — the local one needs none)
  fabos check [claude|gemini|openai|deepseek|local|ollama]   real connection check of the (given or active) AI provider
  fabos ollama status|models|install [--yes]   Ollama (ADR-0022; not bundled): status = installed/running/models/the model the agent
                                     would use; models = what `ollama list` knows, largest first; install = print the official installer
                                     command — with --yes it runs as root through the polkit path (you type your password), never silently
  fabos settings images.provider openai|gemini|local|''   which provider draws for generate_image ('' = the active one, else the key you
                                     have); images.local_endpoint http://host/v1 = a local image server speaking /v1/images/generations (ADR-0021)
  fabos mail-check [--provider P] [--address A]       real SMTP + IMAP sign-in with the stored mail account (exit 0 = both fine)
  fabos mail-signin                                    "Sign in with Google" for Gmail (opens the browser; needs the distributor's OAuth client)
  fabos approvals [--task ID]        pending approvals (optionally only those of one task)
  fabos watches | unwatch ID | log [--limit N] | status [--brief]
  fabos audit verify                 check the tamper-evident (HMAC-chained) activity log; exit 1 when a row was altered
  fabos audit export [--since 24h|7d|ISO] [--out DIR]   write the activity log as JSON Lines (default dir: the policy's
                                     audit_export_dir, else ~/.local/share/fabos/audit); the first line carries the chain head
  fabos policy [--reload]            the administrator's policy (/etc/fabos/policy.json) as the daemon applies it
  fabos disk-unlock status|diagnose|off|on|repair [--admin] [--refresh]   the Start-up setting "Ask for the disk password when the
                                     computer starts" (Fab AI Controls › Settings › General › Start-up): status = the switch AND the real
                                     start-up state; diagnose = every check with its reason (--admin: the complete check as administrator —
                                     the system asks for your password); off = stop asking (you are asked for the disk passphrase, never
                                     echoed); on = ask again; repair = make the start-up files match the switch again (what "Fix now" does)
"""
import argparse, getpass, json, os, sys, time, urllib.request, urllib.error

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "fabos-agent")


def api(method, path, body=None, timeout=30):
    try:
        token = open(os.path.join(RUN, "token")).read().strip()
        port = open(os.path.join(RUN, "port")).read().strip()
    except FileNotFoundError:
        sys.exit("fabos-agentd is not running for this user. Start it: systemctl --user start fabos-agent")
    req = urllib.request.Request("http://127.0.0.1:%s%s" % (port, path), method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            return {"error": json.loads(e.read()).get("error", str(e)), "http": e.code}
        except Exception:
            return {"error": str(e), "http": e.code}
    except urllib.error.URLError as e:
        sys.exit("cannot reach fabos-agentd: %s (systemctl --user status fabos-agent)" % e.reason)


def ts(t):
    return time.strftime("%H:%M:%S", time.localtime(t)) if t else ""


def main():
    ap = argparse.ArgumentParser(prog="fabos", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="print raw JSON")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("do"); p.add_argument("text", nargs="+"); p.add_argument("--mode", choices=["ask", "auto", "bypass"]); p.add_argument("--title"); p.add_argument("--wait", action="store_true")
    p.add_argument("--follow-up", type=int, metavar="ID", help="thread this request into the chat of task ID (the agent gets the earlier context)")
    p = sub.add_parser("tasks"); p.add_argument("--limit", type=int, default=30)
    for c in ("show", "cancel", "retry", "delete", "approve", "deny", "unwatch"):
        sub.add_parser(c).add_argument("id", type=int)
    p = sub.add_parser("edit"); p.add_argument("id", type=int); p.add_argument("--title"); p.add_argument("--request"); p.add_argument("--mode")
    p = sub.add_parser("answer"); p.add_argument("id", type=int); p.add_argument("text", nargs="+")
    p = sub.add_parser("approvals"); p.add_argument("--task", type=int, metavar="ID")
    p = sub.add_parser("mode"); p.add_argument("value", nargs="?", choices=["ask", "auto", "bypass"])
    p = sub.add_parser("settings"); p.add_argument("key", nargs="?"); p.add_argument("value", nargs="?")
    p = sub.add_parser("set-key"); p.add_argument("which", choices=["claude", "gemini", "openai", "deepseek", "local", "ollama", "mail"]); p.add_argument("--remove", action="store_true")
    p = sub.add_parser("check"); p.add_argument("provider", nargs="?", choices=["claude", "gemini", "openai", "deepseek", "local", "ollama"])
    p = sub.add_parser("ollama"); p.add_argument("action", choices=["status", "models", "install"]); p.add_argument("--yes", action="store_true", help="install: really run the official installer (as root, through polkit: you will be asked for your password)")
    p.add_argument("--force", action="store_true", help="install: run the installer even when ollama is already present (it upgrades)")
    p = sub.add_parser("mail-check"); p.add_argument("--provider", choices=["gmail", "outlook", "yahoo", "zoho", "icloud", "other"]); p.add_argument("--address")
    sub.add_parser("mail-signin")
    sub.add_parser("watches")
    p = sub.add_parser("log"); p.add_argument("--limit", type=int, default=50)
    p = sub.add_parser("status"); p.add_argument("--brief", action="store_true")
    p = sub.add_parser("audit"); p.add_argument("action", choices=["verify", "export"]); p.add_argument("--since", metavar="24h|7d|ISO"); p.add_argument("--out", metavar="DIR")
    p = sub.add_parser("policy"); p.add_argument("--reload", action="store_true", help="re-read /etc/fabos/policy.json now (the daemon also reloads on SIGHUP)")
    p = sub.add_parser("disk-unlock"); p.add_argument("action", choices=["status", "diagnose", "off", "on", "repair"])
    p.add_argument("--admin", action="store_true", help="diagnose: the complete check as administrator (the system asks for your password)")
    p.add_argument("--refresh", action="store_true", help="status: look again instead of using the check made in the last 30 s")
    a = ap.parse_args()
    if not a.cmd:
        ap.print_help(); return
    out = None
    if a.cmd == "do":
        body = {"request": " ".join(a.text)}
        if a.mode: body["mode"] = a.mode
        if a.title: body["title"] = a.title
        if a.follow_up: body["parent_id"] = a.follow_up
        out = api("POST", "/tasks", body)
        if not a.json and "id" in out:
            print("Task #%d started. Watch it: fabos show %d  |  Fab AI Controls: fabos-command-center" % (out["id"], out["id"]))
            if a.wait:
                while True:
                    t = api("GET", "/tasks/%d" % out["id"])
                    if t["status"] in ("done", "failed", "cancelled"):
                        print("[%s] %s" % (t["status"], t.get("result") or t.get("error") or "")); break
                    time.sleep(2)
            return
    elif a.cmd == "tasks":
        out = api("GET", "/tasks?limit=%d" % a.limit)
        if not a.json:
            for t in out:
                print("#%-4d %-17s %s  %s" % (t["id"], t["status"], ts(t["updated"]), t["title"]))
            return
    elif a.cmd == "show":
        out = api("GET", "/tasks/%d" % a.id)
        if not a.json and "id" in out:
            print("#%d [%s] %s\nrequest: %s\n" % (out["id"], out["status"], out["title"], out["request"]))
            for s in out["steps"]:
                line = "%s %-10s %-14s" % (ts(s["ts"]), s["kind"], s["name"] or "")
                if s["kind"] == "tool_call": line += " %s %s  %s" % (s["risk"], s["decision"] or "", (s["input"] or "")[:160])
                else: line += " " + (s["output"] or s["input"] or "")[:300].replace("\n", " ")
                print(line)
            for q in out["questions"]:
                if not q["answer"]: print("\nQUESTION (answer with: fabos answer %d \"...\"): %s" % (out["id"], q["question"]))
            for ap_ in out["approvals"]:
                if ap_["status"] == "pending": print("\nAPPROVAL #%d pending: %s %s (%s) -> fabos approve %d | fabos deny %d" % (ap_["id"], ap_["tool"], ap_["input"][:120], ap_["risk"], ap_["id"], ap_["id"]))
            if out.get("result"): print("\nresult: " + out["result"])
            if out.get("error"): print("\nerror: " + out["error"])
            return
    elif a.cmd in ("cancel", "retry"):
        out = api("POST", "/tasks/%d/%s" % (a.id, a.cmd))
    elif a.cmd == "delete":
        out = api("DELETE", "/tasks/%d" % a.id)
    elif a.cmd == "edit":
        out = api("PATCH", "/tasks/%d" % a.id, {k: v for k, v in (("title", a.title), ("request", a.request), ("mode", a.mode)) if v})
    elif a.cmd == "answer":
        out = api("POST", "/tasks/%d/answer" % a.id, {"text": " ".join(a.text)})
    elif a.cmd in ("approve", "deny"):
        out = api("POST", "/approvals/%d" % a.id, {"decision": "approved" if a.cmd == "approve" else "denied"})
    elif a.cmd == "approvals":
        out = api("GET", "/approvals/pending" + ("?task_id=%d" % a.task if a.task else ""))
        if not a.json:
            for x in out: print("#%-4d task #%d %-9s %-12s %s  %s" % (x["id"], x["task_id"], x["risk"], x["tool"], x["reason"], x["input"][:120]))
            if not out: print("no pending approvals")
            return
    elif a.cmd == "mode":
        out = api("PUT", "/settings", {"mode": a.value}) if a.value else {"mode": api("GET", "/settings").get("mode")}
    elif a.cmd == "settings":
        if a.key and a.value is not None: out = api("PUT", "/settings", {a.key: a.value})
        else:
            out = api("GET", "/settings")
            if not a.json:
                for k in sorted(out):
                    if k != "secrets": print("%-22s %s" % (k, out[k]))
                print("secrets: " + ", ".join("%s=%s" % (k, "set" if v else "unset") for k, v in out["secrets"].items())); return
    elif a.cmd == "set-key":
        name = {"claude": "claude_api_key", "gemini": "gemini_api_key", "openai": "openai_api_key", "deepseek": "deepseek_api_key", "local": "local_api_key", "ollama": "ollama_api_key", "mail": "mail_password"}[a.which]
        val = "" if a.remove else getpass.getpass("%s: " % name)
        out = api("POST", "/secrets", {"name": name, "value": val})
    elif a.cmd == "check":
        out = api("POST", "/providers/test", {"provider": a.provider} if a.provider else {})
        if not a.json and "ok" in out:
            print(("Connected to %s · %s · %d ms" % (out.get("provider"), out.get("model"), out.get("latency_ms", 0))) if out["ok"]
                  else ("%s: %s" % (out.get("provider") or "provider", out.get("detail"))))
            if out.get("models_sample"): print("models: " + ", ".join(out["models_sample"]))
            sys.exit(0 if out["ok"] else 1)
    elif a.cmd == "ollama":
        if a.action == "models":
            out = api("GET", "/providers/ollama/models?refresh=1")
            if not a.json:
                if isinstance(out, dict):
                    sys.exit(out.get("error") or "Ollama is not reachable")
                if not out: print("no models installed — e.g. ollama pull qwen2.5:3b"); return
                for m in out: print("%-32s %-8s %-8s %6.1f GB" % (m["name"], m.get("parameter_size") or "?", m.get("quantization") or "", (m.get("size") or 0) / 1e9))
                return
        elif a.action == "status":
            out = api("GET", "/providers/ollama/status")
            if not a.json and "installed" in out:
                print("Ollama: %s · %s · %d model%s · endpoint %s" % ("installed" if out["installed"] else "NOT installed (not bundled with Fab OS; see: fabos ollama install)",
                                                                       "running" if out["running"] else "not running", len(out["models"]), "" if len(out["models"]) == 1 else "s", out["base_url"]))
                print("  model the agent would use: %s (%s) · RAM %s GiB -> up to %sB parameters" % (out["model"] or "none", out["model_source"], out["ram_gib"], out["max_parameters_b"]))
                if out.get("error"): print("  " + out["error"])
                sys.exit(0 if out["running"] else 1)
        else:
            cmd = "curl -fsSL https://ollama.com/install.sh | sh"
            if not a.json:
                print("Ollama is not part of Fab OS (its installer downloads about 1 GB). The official command:\n\n    %s\n" % cmd)
            if not a.yes:                                             # nothing runs without --yes: the command is only shown (JSON: returned)
                if a.json:
                    out = {"ok": False, "ran": False, "command": cmd, "detail": "pass --yes to run the official installer as administrator"}
                else:
                    print("Run `fabos ollama install --yes` to run it now as administrator (the system asks for your password), or run the command yourself."); return
            else:
                if not a.json:
                    print("Running it as administrator now — the system will ask for your password. This can take several minutes...")
                out = api("POST", "/providers/ollama/install", {"confirm": True, "force": bool(a.force)}, timeout=1900)
            if not a.json and "ok" not in out:                       # 403: the administrator's policy (hosts_allowed / cloud_allowed) refused the download
                sys.exit(out.get("error") or "the installer was refused")
            if not a.json and "ok" in out:
                if out.get("already_installed"): print(out["detail"]); return
                print(("Installed: %s" % ("ollama is now available" if out.get("installed") else "the installer finished but `ollama` is not on PATH yet")) if out["ok"]
                      else "Install failed: %s" % (out.get("error") or ("exit %s: %s" % (out.get("exit_code"), (out.get("stderr") or "")[-400:]))))
                print("Next: ollama pull qwen2.5:3b (4 GB machines) or ollama pull llama3.1:8b (8 GB), then: fabos settings provider ollama")
                sys.exit(0 if out["ok"] else 1)
    elif a.cmd == "mail-check":
        body = {k: v for k, v in (("provider", a.provider), ("address", a.address)) if v}
        out = api("POST", "/mail/test", body)
        if not a.json and "ok" in out:
            print("%s · %s · %s" % ("Mail OK" if out["ok"] else "Mail check failed", out.get("provider"), out.get("address") or "(no address)"))
            for leg in ("smtp", "imap"):
                r = out.get(leg) or {}
                print("  %-4s %s %s" % (leg.upper(), "ok  " if r.get("ok") else ("skip" if r.get("skipped") else "FAIL"), r.get("detail", "")))
            print("  %d ms · auth: %s" % (out.get("latency_ms", 0), out.get("auth")))
            sys.exit(0 if out["ok"] else 1)
    elif a.cmd == "mail-signin":
        out = api("POST", "/mail/oauth/start", {"provider": "gmail"})
        if not a.json:
            if not out.get("ok"):
                sys.exit(out.get("detail") or out.get("error") or "sign-in unavailable")
            print("Finish the sign-in in the browser window%s.\nIf it did not open, visit:\n  %s" % ("" if out.get("browser_opened") else " (could not open one)", out["url"]))
            while True:
                st = api("GET", "/mail/oauth/status?flow_id=" + out["flow_id"])
                if st.get("state") != "pending":
                    print("%s: %s%s" % (st.get("state"), st.get("detail"), (" as " + st["address"]) if st.get("address") else ""))
                    sys.exit(0 if st.get("state") == "done" else 1)
                time.sleep(2)
    elif a.cmd == "watches":
        out = api("GET", "/watches")
        if not a.json:
            for w in out: print("#%-3d task #%d %-8s %-12s every %4ds hits=%d last=%s" % (w["id"], w["task_id"], w["status"], w["kind"], w["interval_s"], w["hits"], (w["last_result"] or "")[:60]))
            return
    elif a.cmd == "unwatch":
        out = api("DELETE", "/watches/%d" % a.id)
    elif a.cmd == "log":
        out = api("GET", "/activity?limit=%d" % a.limit)
        if not a.json:
            for e in reversed(out): print("%s %-7s %-18s %s %s" % (ts(e["ts"]), e["actor"], e["kind"], ("#%d" % e["task_id"]) if e["task_id"] else "", (e["detail"] or "")[:120].replace("\n", " ")))
            return
    elif a.cmd == "audit":
        if a.action == "verify":
            out = api("GET", "/audit/verify")
            if not a.json and "ok" in out:
                print("Audit chain %s: %d rows, %d signed, %d unsigned%s, head %s" % ("OK" if out["ok"] else "BROKEN", out["rows"], out["signed"], out["unsigned"],
                                                                                    (", first altered or missing row #%s" % out["first_bad"]) if out.get("first_bad") else "", (out.get("head") or "-")[:16]))
                sys.exit(0 if out["ok"] else 1)
        else:
            out = api("POST", "/audit/export", {k: v for k, v in (("since", a.since), ("out_dir", a.out)) if v})
            if not a.json and "path" in out:
                print("Exported %d rows to %s (chain %s)" % (out["rows"], out["path"], "OK" if out["verify"]["ok"] else "BROKEN"))
                sys.exit(0 if out["verify"]["ok"] else 1)
    elif a.cmd == "policy":
        out = api("POST", "/policy/reload") if a.reload else api("GET", "/policy")
        if not a.json and "managed" in out:
            print("Managed by your organisation: %s  (%s)" % ("yes" if out["managed"] else "no", out["path"]))
            for k in ("mode_max", "providers_allowed", "cloud_allowed", "tools_denied", "hosts_allowed", "audit_export_dir", "require_password_for_root", "sandbox_network"):
                print("  %-26s %s" % (k, out.get(k)))
            if out.get("error"): print("  error: " + out["error"])
            if out.get("unknown_keys"): print("  unknown keys: " + ", ".join(out["unknown_keys"]))
            return
    elif a.cmd == "disk-unlock":
        # the Start-up setting. status/diagnose read GET /system/disk-unlock (the daemon's user-level check, cached 30 s); --admin, off,
        # on and repair POST and go through the polkit root path (the system asks for your password). The disk passphrase is read with
        # getpass (never echoed, never an argument) and travels only in the request body to the local daemon.
        def du_real(d):
            exp = d.get("prompt_at_boot_expected")
            if d.get("boot_risk"): return "the computer may NOT START (see below)"
            return {True: "yes", False: "no"}.get(exp, "cannot tell without administrator rights")
        def du_print_diag(d):
            marks = {"pass": "ok  ", "fail": "FAIL", "unknown": " ?  ", "info": "info"}
            for it in d.get("items") or []:
                print("  [%s] %s\n         %s" % (marks.get(it.get("result"), "    "), it.get("label"), it.get("detail")))
            print("Start-up asks for the disk password: %s%s" % (du_real(d), " (checked as administrator)" if d.get("as_root") else ""))
            if d.get("reason"): print("  " + str(d["reason"]))
            if d.get("repair"): print("  What to do: " + str(d["repair"]))
        def du_exit(d):
            sys.exit(0 if d.get("agrees") is not False and not d.get("boot_risk") else 1)
        if a.action in ("status", "diagnose") and not a.admin:
            out = api("GET", "/system/disk-unlock" + ("?refresh=1" if (a.refresh or a.action == "diagnose") else ""))
            if not a.json and "encrypted" in out:
                d = out.get("diagnosis") or {}
                if not out.get("encrypted"):
                    print("This computer's disk is not encrypted: there is no disk password at start-up. (A password asked at start-up is the login screen's — a different thing.)")
                    if out.get("error"): print("  " + str(out["error"]))
                    return
                print("Switch (Fab AI Controls › Settings › General › Start-up): %s — %s" % ("ON, ask for the disk password" if out.get("prompt_at_boot") else "OFF, start without asking", out.get("detail") or ""))
                if a.action == "status":
                    print("Start-up asks for the disk password: %s (checked %s%s)" % (du_real(d), d.get("checked_at") or "now", ", as administrator" if d.get("as_root") else ""))
                    if d.get("agrees") is False: print("  MISMATCH: %s\n  Fix: fabos disk-unlock repair" % d.get("reason"))
                    elif d.get("agrees") is None and d.get("needs_root"): print("  %s\n  Complete check: fabos disk-unlock diagnose --admin" % d.get("reason"))
                    lr = out.get("last_request") or {}
                    if lr.get("ok") is False: print("  The last change asked for (%s, turn %s) did NOT complete: %s" % (ts(lr.get("at")), "off" if lr.get("prompt_at_boot") is False else ("on" if lr.get("prompt_at_boot") else lr.get("action")), lr.get("error")))
                    if d.get("error"): print("  " + str(d["error"]))
                else:
                    du_print_diag(d)
                du_exit(d)
        elif a.action == "diagnose":
            if not a.json: print("Checking as administrator — the system will ask for your password.")
            out = api("POST", "/system/disk-unlock", {"action": "diagnose"}, timeout=700)
            if not a.json and "ok" in out:
                if not out["ok"]: sys.exit("The check did not run: %s" % (out.get("error") or "unknown error"))
                d = out.get("diagnosis") or {}; du_print_diag(d); du_exit(d)
        else:
            body = {"prompt_at_boot": True} if a.action == "on" else ({"action": "repair"} if a.action == "repair" else {"prompt_at_boot": False})
            if a.action in ("off", "repair"):
                st = api("GET", "/system/disk-unlock")
                if not st.get("encrypted"): sys.exit("this computer's disk is not encrypted: there is no disk password to ask for")
                if a.action == "off" or st.get("prompt_at_boot") is False:
                    if a.action == "off" and not a.json:
                        print("Your files stay encrypted on the drive, but anyone who starts this computer can use it without a password:\nthe unlock key is stored in the start-up files on the unencrypted /boot partition. Use this only where the computer itself is secure.")
                    body["passphrase"] = getpass.getpass("Current disk passphrase (not shown): ")
                    if not body["passphrase"]: sys.exit("no passphrase given; nothing was changed")
            if not a.json: print("Running as administrator — the system will ask for your password. This takes a minute or two…")
            out = api("POST", "/system/disk-unlock", body, timeout=1300)
            if not a.json and "ok" in out:
                for s_ in out.get("steps") or []: print("  " + str(s_))
                print(("Done: %s" % (out.get("detail") or "")) if out["ok"] else ("NOT changed: %s" % (out.get("error") or "unknown error")))
                if isinstance(out.get("diagnosis"), dict): du_print_diag(out["diagnosis"])
                sys.exit(0 if out["ok"] else 1)
    elif a.cmd == "status":
        out = api("GET", "/status")
        if a.brief and "mode" in out:
            t = out["tasks"]; parts = []
            for k in ("running", "waiting_approval", "waiting_user", "queued"):
                if t.get(k): parts.append("%d %s" % (t[k], k.replace("_", " ")))
            last = out["latest"][0] if out["latest"] else None
            s = " · ".join(parts) or "idle"
            if out["pending_approvals"]: s += " · %d approval%s pending" % (out["pending_approvals"], "s" if out["pending_approvals"] > 1 else "")
            if last: s += " · last #%d %s: %s" % (last["id"], last["status"], (last["title"] or "")[:50])
            if not out["provider_ready"]: s = "AI provider not configured — open Fab AI Controls → Settings · " + s
            if (out.get("policy") or {}).get("managed"): s += " · Managed by your organisation"
            print(s); return
    print(json.dumps(out, indent=1, default=str) if out is not None else "")
    if isinstance(out, dict) and int(out.get("http") or 0) >= 400:       # the daemon refused it: the exit code says so too
        sys.exit(1)


if __name__ == "__main__":
    main()
