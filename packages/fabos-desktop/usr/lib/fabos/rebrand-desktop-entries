#!/bin/sh
# Fab OS: hide upstream vendor names in what the user sees, without touching Ubuntu/KDE package files.
# Writes overriding .desktop files to /usr/local/share/applications (higher XDG priority). Re-run after upgrades
# by the apt hook /etc/apt/apt.conf.d/90fabos-rebrand. Safe: originals are untouched; delete the overrides to revert.
set -eu
OUT=/usr/local/share/applications; mkdir -p "$OUT"
rebrand() { # rebrand <src> <dst> <sed-expr>   (line rules, every group)
  sed -E "$3" "$1" > "$2.tmp" && mv "$2.tmp" "$2"; }
rebrand_entry() { # rebrand_entry <src> <dst> <name> [<generic>]   Name/GenericName of the [Desktop Entry] group only;
  # [Desktop Action …] groups keep their own names ("Open a New Window" must not become the app name)
  awk -v name="$3" -v generic="${4:-}" '
    /^\[/ { main = ($0 == "[Desktop Entry]") }
    main && /^Name(\[[^]]+\])?=/ { sub(/=.*/, "=" name) }
    main && generic != "" && /^GenericName(\[[^]]+\])?=/ { sub(/=.*/, "=" generic) }
    { print }' "$1" > "$2.tmp" && mv "$2.tmp" "$2"; }
PRODUCT_RULES='s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bKonsole\b/\1Fab Terminal/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bDolphin\b/\1Fab Files/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bKate\b/\1Fab Editor/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bOkular\b/\1Fab Documents/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bGwenview\b/\1Fab Photos/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bKCalc\b/\1Fab Calculator/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bSpectacle\b/\1Fab Screenshot/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bKRunner\b/\1Fab Search/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)\bKWin\b/\1Window Manager/'
KDE_RULES='s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE Plasma/\1Fab OS/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE Connect/\1Fab Connect/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE /\1/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)Plasma’s/\1Fab OS’s/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)Plasma'"'"'s/\1Fab OS'"'"'s/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)Plasma /\1Fab OS /; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*) for KDE/\1/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE/\1Fab OS/'
# Visible names for upstream apps (launcher, dock, search, shortcuts). Format: file|Name|GenericName
NAMES="
org.kde.konsole.desktop|Fab Terminal|Terminal
org.kde.dolphin.desktop|Fab Files|File Manager
org.kde.kate.desktop|Fab Editor|Text Editor
org.kde.discover.desktop|Fab Software|Software Center
org.kde.discover.notifier.desktop|Fab Software Updater|
org.kde.discover.flatpak.desktop|Fab Software|Software Center
org.kde.discover.snap.desktop|Fab Software|Software Center
org.kde.discover.urlhandler.desktop|Fab Software|Software Center
org.kde.discover.apt.urlhandler.desktop|Fab Software|Software Center
org.kde.gwenview.desktop|Fab Photos|Image Viewer
org.kde.gwenview_importer.desktop|Fab Photos Importer|Photo Importer
org.kde.okular.desktop|Fab Documents|Document Viewer
org.kde.kcalc.desktop|Fab Calculator|Calculator
org.kde.ark.desktop|Fab Archives|Archiving Tool
org.kde.spectacle.desktop|Fab Screenshot|Screenshot Capture
org.kde.kinfocenter.desktop|Fab System Info|System Information
org.kde.plasma-systemmonitor.desktop|Fab Monitor|System Monitor
org.kde.krunner.desktop|Fab Search|Search
org.kde.klipper.desktop|Fab Clipboard|Clipboard Manager
org.kde.kmenuedit.desktop|Fab Menu Editor|Menu Editor
org.kde.kfontview.desktop|Fab Fonts|Font Viewer
org.kde.partitionmanager.desktop|Fab Disks|Partition Manager
org.kde.kwalletmanager.desktop|Fab Wallet|Password Wallet
org.kde.kdeconnect.app.desktop|Fab Connect|Device Connect
kdesystemsettings.desktop|Fab Settings|System Settings
kcm_krunnersettings.desktop|Fab Search Setup|
org.kde.kded6.desktop|Fab OS Background Services|
kcm_kwin_scripts.desktop|WM Scripting|
systemsettings.desktop|Fab Settings|System Settings
org.kde.elisa.desktop|Fab Music|Music Player
org.kde.haruna.desktop|Fab Videos|Media Player
fabos-command-center.desktop|Fab AI Controls|AI Controls
fabos-updates.desktop|Fab Updates|Software Updates
fabos-feedback.desktop|Fab Feedback|Feedback and bug reports
"
name_for() { echo "$NAMES" | awk -F'|' -v b="$1" '$1==b{print $2}'; }
generic_for() { echo "$NAMES" | awk -F'|' -v b="$1" '$1==b{print $3}'; }

for f in /usr/share/applications/*.desktop; do
  b=$(basename "$f"); [ -f "$OUT/$b" ] && [ ! -f "$OUT/$b.fabos" ] && continue   # respect hand-made overrides
  case "$b" in
    org.kde.ksecretd.desktop) rebrand_entry "$f" "$OUT/$b" "Fab Wallet Service"; touch "$OUT/$b.fabos" ;;
    org.kde.kwalletmanager.desktop|org.kde.kwalletmanager5.desktop|kwalletmanager5.desktop|kwalletmanager5-kwalletd.desktop)
      rebrand_entry "$f" "$OUT/$b" "Fab Wallet" "Password Wallet"
      rebrand "$OUT/$b" "$OUT/$b" 's/^(Comment(\[[a-zA-Z_@.]+\])?=).*/\1Manage the passwords and secrets stored by Fab OS/'; touch "$OUT/$b.fabos" ;;
    *)
      name=$(name_for "$b")
      if [ -n "$name" ]; then
        rebrand_entry "$f" "$OUT/$b" "$name" "$(generic_for "$b")"; rebrand "$OUT/$b" "$OUT/$b" "$KDE_RULES"; touch "$OUT/$b.fabos"
      elif grep -qE '^(Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*(KDE|Plasma|\b(Konsole|Dolphin|Kate|Okular|Gwenview|KCalc|Spectacle|KRunner|KWin)\b)' "$f"; then
        rebrand "$f" "$OUT/$b" "$KDE_RULES; $PRODUCT_RULES"; touch "$OUT/$b.fabos"
      fi ;;
  esac
done
# System Settings modules (KCMs) that carry the KDE name in their title
for f in /usr/share/applications/kcm_kwallet*.desktop; do [ -f "$f" ] || continue; b=$(basename "$f")
  rebrand_entry "$f" "$OUT/$b" "Fab Wallet"; rebrand "$OUT/$b" "$OUT/$b" 's/^(Comment(\[[a-zA-Z_@.]+\])?=).*/\1Fab Wallet configuration/'; touch "$OUT/$b.fabos"; done
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$OUT" || true

# Shortcuts page (Fab Settings > Shortcuts) lists global-shortcut components by these names
KG=/usr/local/share/kglobalaccel; mkdir -p "$KG"
for f in /usr/share/kglobalaccel/*.desktop; do [ -f "$f" ] || continue; b=$(basename "$f"); name=$(name_for "$b")
  if [ -n "$name" ]; then rebrand_entry "$f" "$KG/$b" "$name"; rebrand "$KG/$b" "$KG/$b" "$KDE_RULES"
  elif grep -qE '^(Name|Comment)(\[[a-zA-Z_@.]+\])?=.*(KDE|Plasma|KWin)' "$f"; then
    rebrand "$f" "$KG/$b" "$KDE_RULES; s/^(Name(\[[a-zA-Z_@.]+\])?=)Plasma$/\1Fab OS Desktop/; s/^(Name(\[[a-zA-Z_@.]+\])?=)KWin$/\1Window Manager/"
  fi
done
# Web shortcut "Ubuntu Package Search" is not ours: hide it (same mechanism the Web Shortcuts settings page uses)
mkdir -p /usr/local/share/kf6/searchproviders
printf '[Desktop Entry]\nType=Service\nHidden=true\n' > /usr/local/share/kf6/searchproviders/ubuntu.desktop
# Software Sources (software-properties-qt) cannot run on Fab OS (python-apt has no distro template for fabos) and Fab Updates
# covers channel management, so its entry is hidden; Fab Software then drops its "Software Sources" button.
if [ -f /usr/share/applications/software-properties-qt.desktop ]; then
  { cat /usr/share/applications/software-properties-qt.desktop; echo "Hidden=true"; } > "$OUT/software-properties-qt.desktop.tmp" && mv "$OUT/software-properties-qt.desktop.tmp" "$OUT/software-properties-qt.desktop"; touch "$OUT/software-properties-qt.desktop.fabos"
  for f in /usr/lib/python3/dist-packages/softwareproperties/qt/SoftwarePropertiesQt.py /usr/share/software-properties/designer/main.ui; do
    [ -f "$f.fabos-orig" ] && mv -f "$f.fabos-orig" "$f"; done
fi
# KConfig-localised files no catalog reaches: rewritten in place from a kept .fabos-orig copy (same pattern every run)
inplace() { # inplace <file> <sed-expr>
  [ -f "$1" ] || return 0; src="$1"; [ -f "$1.fabos-orig" ] && src="$1.fabos-orig"
  if sed -E "$2" "$src" | cmp -s - "$1"; then return 0; fi
  [ -f "$1.fabos-orig" ] || cp -p "$1" "$1.fabos-orig"; sed -E "$2" "$1.fabos-orig" > "$1.tmp" && mv "$1.tmp" "$1"; }
# product names first (before the generic "KDE " removal), then the generic KDE/Plasma rules
NOTIFY_RULES='s/^((Name|Comment)(\[[a-zA-Z_@.]+\])?=.*)KDE Wallet/\1Fab Wallet/; s/^((Name|Comment)(\[[a-zA-Z_@.]+\])?=.*)KWallet/\1Fab Wallet/; s/^((Name|Comment)(\[[a-zA-Z_@.]+\])?=.*)KWin Window Manager/\1Fab OS Window Manager/; s/^((Name|Comment)(\[[a-zA-Z_@.]+\])?=.*)\bDiscover\b/\1Fab Software/'"; $PRODUCT_RULES; $KDE_RULES"
for f in /usr/share/knotifications6/*.notifyrc; do
  rules="$NOTIFY_RULES"; [ "$(basename "$f")" = kwin.notifyrc ] && rules="$rules; s/^\[Global\]$/[Global]\nName=Fab OS Window Manager/"
  grep -qE '^(Name|Comment)(\[[a-zA-Z_@.]+\])?=.*(KDE|Plasma|KWallet|Konsole|Discover|Spectacle|KWin|Dolphin|Kate)' "$f" || continue
  inplace "$f" "$rules"
done
for f in /usr/share/solid/actions/gwenview_importer.desktop /usr/share/solid/actions/gwenview_importer_camera.desktop; do
  inplace "$f" 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Download Photos with Fab Photos/'; done
inplace /usr/share/knsrcfiles/plasmoids.knsrc 's/^Name=Plasma Widgets$/Name=Fab OS Widgets/'
inplace /usr/share/knsrcfiles/plasma-themes.knsrc 's/^Name=Plasma Styles$/Name=Fab OS Styles/'
inplace /usr/share/plasma/kinfocenter/externalmodules/kcm_external_plasma-systemmonitor.desktop 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Fab Monitor/'
inplace /usr/share/plasma/plasmoids/org.kde.plasma.systemmonitor/metadata.json 's/"System Monitor Sensor"/"Fab Monitor Sensor"/'
# Fab Files context menu on executables: "Run In Konsole" -> "Run In Terminal" (first file per basename across data dirs wins)
if [ -f /usr/share/kio/servicemenus/konsolerun.desktop ]; then mkdir -p /usr/local/share/kio/servicemenus
  sed -E 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Run In Terminal/; s/^(Comment(\[[a-zA-Z_@.]+\])?=).*/\1Run within the terminal/' /usr/share/kio/servicemenus/konsolerun.desktop > /usr/local/share/kio/servicemenus/konsolerun.desktop; fi
command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime >/dev/null 2>&1 || true
[ -x /usr/lib/fabos/rebrand-binaries ] && /usr/lib/fabos/rebrand-binaries || true
[ -x /usr/lib/fabos/rebrand-catalogs ] && /usr/lib/fabos/rebrand-catalogs || true
exit 0
