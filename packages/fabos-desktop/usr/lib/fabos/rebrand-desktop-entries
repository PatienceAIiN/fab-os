#!/bin/sh
# Fab OS: hide upstream vendor names in what the user sees, without touching Ubuntu/KDE package files.
# Writes overriding .desktop files to /usr/local/share/applications (higher XDG priority). Re-run after upgrades
# by the apt hook /etc/apt/apt.conf.d/90fabos-rebrand. Safe: originals are untouched; delete the overrides to revert.
set -eu
OUT=/usr/local/share/applications; mkdir -p "$OUT"
rebrand() { # rebrand <src> <dst> <sed-expr>
  sed -E "$3" "$1" > "$2.tmp" && mv "$2.tmp" "$2"; }
# Visible names for upstream apps (launcher, dock, search). Format: file|Name|GenericName
NAMES="
org.kde.konsole.desktop|Fab Terminal|Terminal
org.kde.dolphin.desktop|Fab Files|File Manager
org.kde.kate.desktop|Fab Editor|Text Editor
org.kde.discover.desktop|Fab Software|Software Center
org.kde.gwenview.desktop|Fab Photos|Image Viewer
org.kde.okular.desktop|Fab Documents|Document Viewer
org.kde.kcalc.desktop|Fab Calculator|Calculator
org.kde.ark.desktop|Fab Archives|Archiving Tool
org.kde.spectacle.desktop|Fab Screenshot|Screenshot Capture
org.kde.kinfocenter.desktop|Fab System Info|System Information
org.kde.plasma-systemmonitor.desktop|Fab Monitor|System Monitor
org.kde.krunner.desktop|Fab Search|Search
org.kde.klipper.desktop|Fab Clipboard|Clipboard Manager
org.kde.kmenuedit.desktop|Fab Menu Editor|Menu Editor
org.kde.kfontview.desktop|Fab Fonts|Font Viewer
org.kde.partitionmanager.desktop|Fab Disks|Partition Manager
org.kde.kwalletmanager.desktop|Fab Wallet|Password Wallet
org.kde.kdeconnect.app.desktop|Fab Connect|Device Connect
kdesystemsettings.desktop|Fab Settings|System Settings
systemsettings.desktop|Fab Settings|System Settings
org.kde.elisa.desktop|Fab Music|Music Player
org.kde.haruna.desktop|Fab Videos|Media Player
fabos-command-center.desktop|Fab Command Center|AI Agent Command Center
fabos-updates.desktop|Fab Updates|Software Updates
fabos-feedback.desktop|Fab Feedback|Feedback and bug reports
"
apply_names() {
  echo "$NAMES" | while IFS='|' read -r file name generic; do
    [ -n "$file" ] && [ -f "/usr/share/applications/$file" ] || continue
    rebrand "/usr/share/applications/$file" "$OUT/$file" "s/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1$name/; s/^(GenericName(\[[a-zA-Z_@.]+\])?=).*/\1$generic/; s/^((Comment)(\[[a-zA-Z_@.]+\])?=.*)KDE /\1/; s/^((Comment)(\[[a-zA-Z_@.]+\])?=.*)KDE/\1Fab OS/"
    touch "$OUT/$file.fabos"
  done
}

for f in /usr/share/applications/*.desktop; do
  b=$(basename "$f"); [ -f "$OUT/$b" ] && [ ! -f "$OUT/$b.fabos" ] && continue   # respect hand-made overrides
  case "$b" in
    org.kde.ksecretd.desktop)
      rebrand "$f" "$OUT/$b" 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Fab Wallet Service/'; touch "$OUT/$b.fabos" ;;
    org.kde.kwalletmanager.desktop|org.kde.kwalletmanager5.desktop|kwalletmanager5.desktop|kwalletmanager5-kwalletd.desktop)
      rebrand "$f" "$OUT/$b" 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Fab Wallet/; s/^(GenericName(\[[a-zA-Z_@.]+\])?=).*/\1Password Wallet/; s/^(Comment(\[[a-zA-Z_@.]+\])?=).*/\1Manage the passwords and secrets stored by Fab OS/'; touch "$OUT/$b.fabos" ;;
    *)
      if grep -qE '^(Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*(KDE|Plasma)' "$f"; then
        rebrand "$f" "$OUT/$b" 's/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE Plasma/\1Fab OS/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE Connect/\1Fab Connect/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE /\1/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)Plasma /\1Fab OS /; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*) for KDE/\1/; s/^((Name|Comment|GenericName)(\[[a-zA-Z_@.]+\])?=.*)KDE/\1Fab OS/'
        touch "$OUT/$b.fabos"
      fi ;;
  esac
done
apply_names
# System Settings modules (KCMs) that carry the KDE name in their title
for f in /usr/share/applications/kcm_kwallet*.desktop; do [ -f "$f" ] || continue; b=$(basename "$f")
  rebrand "$f" "$OUT/$b" 's/^(Name(\[[a-zA-Z_@.]+\])?=).*/\1Fab Wallet/; s/^(Comment(\[[a-zA-Z_@.]+\])?=).*/\1Fab Wallet configuration/'; touch "$OUT/$b.fabos"; done
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$OUT" || true
[ -x /usr/lib/fabos/rebrand-binaries ] && /usr/lib/fabos/rebrand-binaries || true
exit 0
