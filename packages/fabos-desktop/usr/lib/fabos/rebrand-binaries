#!/usr/bin/env python3
"""Fab OS vendor-string rebrand for a short list of binaries and English message catalogs.

Most visible text is renamed by translation catalogs (see rebrand-catalogs).  This script only covers what no catalog
can reach: plugin metadata (System Settings module names live in JSON/CBOR inside the .so) and a few literals.
Rules are strictly LENGTH-PRESERVING so nothing shifts:
  * UTF-8 rules contain a space or are whole NUL-terminated words (\0word\0) -> they can never be part of a mangled
    symbol, an identifier, a path or a Qt resource name, so dynamic linking and resource lookup are unaffected.
  * UTF-16LE rules must contain a space as well (Qt QStringLiteral display text).  Bare words are NOT allowed: Qt
    resource name tables are UTF-16BE and a bare UTF-16LE word matches them at odd offsets (this once broke Discover).
Originals are kept as <file>.fabos-orig and patching always restarts from the original, so rule changes converge.
Idempotent; re-run by the apt Post-Invoke hook after upgrades.  See legal/PATCHED-BINARIES.md.
"""
import glob, os, shutil

LIB = "/usr/lib/x86_64-linux-gnu"
PLUG = LIB + "/qt6/plugins"

# --- rule sets (old, new): identical byte length per encoding -------------------------------------------------------
WALLET = [("KDE Wallet", "Fab Wallet"), ("KDE wallet", "Fab wallet"), ("KWallet Manager", "Fab Wallet Tool"), ("KWallet ", "Wallet  ")]
ABOUT = [("About &KDE", "About &Fab"), ("About KDE", "About Fab"),
         ("KDE Plasma Version", "Desktop UI Version"), ("KDE Frameworks Version", "UI Frameworks Version "),
         ("KDE Plasma", "Fab OS UI "), ("KDE Frameworks", "UI Frameworks ")]
NAMES = [("System Settings", "Fab OS Settings"), ("System Monitor", "Fab OS Monitor"), ("Info Center", "System Info")]
KONSOLE = [("Konsole ", "Console "), (" Konsole", " Console"), ("— Konsole", "— Console")]
PLASMA = ABOUT + [("Plasma ", "Fab OS "),                       # "Plasma Style" -> "Fab OS Style", "Plasma Search" -> "Fab OS Search", ...
                  ("KWin Scripts", "WM Scripting"), ("Manage KWin scripts", "Manage WM scripting"),
                  ("KRunner Settings", "Fab Search Setup"), ("Configure KRunner behavior", "Set up Fab Search behavior")]
COMMON = WALLET + ABOUT + NAMES + KONSOLE
# whole NUL-terminated words (\0word\0): standalone C literals only
NUL_KONSOLE = [("Konsole", "Console")]
NUL_PACKAGEKIT = [("Ubuntu ", "Fab OS ")]                        # origin label shown by Fab Software for archive packages

# exported for rebrand-catalogs: msgids these UTF-8 rules rewrite inside binaries need alias entries in the catalogs
ALIAS_UTF8 = COMMON
ALIAS_NUL = NUL_KONSOLE

# --- targets: (globs, utf8 rules, utf16 rules, nul rules) ----------------------------------------------------------
GROUPS = [
    ([PLUG + "/plasma/kcms/*/kcm_kwallet*.so", PLUG + "/plasma/kcms/**/*about-distro*.so", PLUG + "/kf6/kded/kwalletd6.so",
      LIB + "/libKF6Wallet.so.6*", LIB + "/libKF6XmlGui.so.6*", LIB + "/libKF6WidgetsAddons.so.6*",
      "/usr/bin/kwalletd6", "/usr/bin/ksecretd", "/usr/bin/kwalletmanager5", "/usr/bin/kinfocenter", "/usr/bin/systemsettings",
      "/usr/bin/plasma-systemmonitor"],
     COMMON, COMMON, []),
    (["/usr/bin/konsole", LIB + "/libkonsoleprivate.so.*", LIB + "/libkonsoleapp.so.*", PLUG + "/kf6/parts/konsolepart.so"],
     COMMON, COMMON, NUL_KONSOLE),
    ([PLUG + "/plasma/kcms/**/*.so", PLUG + "/kf6/kded/*.so", PLUG + "/kf6/krunner/*.so", PLUG + "/plasma/applets/*.so",
      PLUG + "/kf6/kfileitemaction/*.so", "/usr/bin/krunner", "/usr/bin/kded6"],
     PLASMA, PLASMA, []),
    ([LIB + "/packagekit-backend/libpk_backend_apt.so"], [], [], NUL_PACKAGEKIT),
]
MO_TARGETS = ["/usr/share/locale/en*/LC_MESSAGES/kcmkwallet.mo", "/usr/share/locale/en*/LC_MESSAGES/kwalletd6.mo",
              "/usr/share/locale/en*/LC_MESSAGES/kwalletmanager.mo", "/usr/share/locale/en*/LC_MESSAGES/kcm_about-distro.mo",
              "/usr/share/locale/en*/LC_MESSAGES/kxmlgui6.mo", "/usr/share/locale/en*/LC_MESSAGES/konsole.mo"]
MO_EXTRA = [("KWallet", "Wallet "), ("Konsole", "Console"), ("KDE e.V.", "Fab OS  ")]


def _check(rules, enc):
    for a, b in rules:
        assert len(a.encode(enc)) == len(b.encode(enc)), (a, b)
        if enc == "utf-16-le":
            assert " " in a, ("UTF-16 rules must contain a space", a)


def apply(data, rules_utf8, rules_utf16, rules_nul):
    new = data
    for a, b in rules_nul:
        new = new.replace(b"\x00" + a.encode() + b"\x00", b"\x00" + b.encode() + b"\x00")
    for a, b in rules_utf16:
        new = new.replace(a.encode("utf-16-le"), b.encode("utf-16-le"))
    for a, b in rules_utf8:
        new = new.replace(a.encode(), b.encode())
    return new


def patch(path, rules_utf8, rules_utf16, rules_nul=()):
    orig = path + ".fabos-orig"
    src = orig if os.path.exists(orig) else path
    data = open(src, "rb").read()
    new = apply(data, rules_utf8, rules_utf16, rules_nul)
    if new == data:
        if src == orig:                       # rules no longer touch this file: put the original back
            os.replace(orig, path); print("restored", path)
        return
    if open(path, "rb").read() == new:
        return
    if not os.path.exists(orig):
        shutil.copy2(path, orig)
    tmp = path + ".fabos-tmp"
    open(tmp, "wb").write(new); shutil.copymode(src, tmp); os.replace(tmp, path)
    print("patched", path)


def main():
    # merge the rules of every group a file belongs to, then patch each file exactly once (always from its original)
    plan = {}
    for globs, u8, u16, nul in GROUPS:
        _check(u8, "utf-8"); _check(u16, "utf-16-le"); _check(nul, "utf-8")
        for pat in globs:
            for p in glob.glob(pat, recursive=True):
                if not os.path.isfile(p) or os.path.islink(p) or p.endswith((".fabos-orig", ".fabos-tmp")):
                    continue
                p = os.path.realpath(p)                      # /usr/bin/X11 -> /usr/bin: one plan entry per real file
                a, b, c = plan.setdefault(p, ([], [], []))
                a += [r for r in u8 if r not in a]; b += [r for r in u16 if r not in b]; c += [r for r in nul if r not in c]
    for p, (u8, u16, nul) in sorted(plan.items()):
        patch(p, u8, u16, nul)
    for pat in MO_TARGETS:
        for p in glob.glob(pat):
            if os.path.isfile(p) and not p.endswith((".fabos-orig", ".fabos-tmp")):
                p = os.path.realpath(p); plan[p] = None; patch(p, COMMON + MO_EXTRA, [])
    # binaries/catalogs patched by an earlier rule set that are no longer targets: put the originals back
    # (only where this script writes; text files patched by rebrand-desktop-entries keep their own .fabos-orig)
    sweep = glob.glob("/usr/bin/*.fabos-orig") + glob.glob(LIB + "/**/*.fabos-orig", recursive=True) + glob.glob("/usr/share/locale/**/*.fabos-orig", recursive=True)
    for orig in sweep:
        orig = os.path.realpath(orig); p = orig[:-len(".fabos-orig")]
        if p not in plan and os.path.isfile(orig) and not os.path.islink(orig):
            os.replace(orig, p); print("restored", p)


if __name__ == "__main__":
    main()
