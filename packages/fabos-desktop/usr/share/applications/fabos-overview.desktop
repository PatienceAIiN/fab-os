[Desktop Entry]
Type=Application
Name=Fab Overview
GenericName=Task View
Comment=See all open windows and desktops at once (also: top-left corner or Meta+W)
Exec=qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut Overview
Icon=fabos-overview
Terminal=false
Categories=Utility;
Keywords=overview;task view;windows;multitasking;
StartupNotify=false
X-KDE-StartupNotify=false
