[Desktop Entry]
Type=Application
Name=@DISTRO_NAME@
Comment=@DISTRO_NAME@ desktop by @VENDOR_NAME@ (Wayland)
Exec=/usr/lib/x86_64-linux-gnu/libexec/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
TryExec=/usr/bin/startplasma-wayland
DesktopNames=KDE
X-KDE-PluginInfo-Version=@DISTRO_VERSION@
