#!/bin/sh
set -e
case "$1" in configure)
  # make sure the greeter has our background/wordmark images (copied from assets at build)
  command -v fc-cache >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1 || true
  # default user avatar (greeter + launcher): divert sddm's placeholder so upgrades never clobber ours.
  # fabos-face.png is the bare mark (512 px, transparent) with a thin white halo so it reads over any wallpaper.
  f=/usr/share/sddm/faces/.face.icon
  if [ -e "$f" ] && ! dpkg-divert --list "$f" | grep -q fabos-desktop; then dpkg-divert --package fabos-desktop --add --rename --divert "$f.sddm" "$f"; fi
  ln -sfn /usr/share/pixmaps/fabos-face.png "$f"
  # Fab Dark / Fab Light colour schemes: Breeze structure with the Fab OS palette (accent 6E9BFF/3B6EF5, ink surfaces)
  D=/usr/share/color-schemes
  if [ -f $D/BreezeDark.colors ]; then
    sed -e 's/^Name=.*/Name=Fab Dark/' -e 's/^ColorScheme=.*/ColorScheme=FabDark/' \
        -e '/^\[Colors:Window\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=15,20,32/;s/^BackgroundAlternate=.*/BackgroundAlternate=23,29,43/}' \
        -e '/^\[Colors:View\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=23,29,43/;s/^BackgroundAlternate=.*/BackgroundAlternate=31,39,55/}' \
        -e '/^\[Colors:Button\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=31,39,55/}' \
        -e '/^\[Colors:Header\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=15,20,32/}' \
        -e 's/^DecorationFocus=.*/DecorationFocus=110,155,255/' -e 's/^DecorationHover=.*/DecorationHover=110,155,255/' \
        -e '/^\[Colors:Selection\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=59,110,245/}' \
        -e '/^\[WM\]/,/^\[/{s/^activeBackground=.*/activeBackground=15,20,32/;s/^inactiveBackground=.*/inactiveBackground=23,29,43/}' \
        $D/BreezeDark.colors > $D/FabDark.colors
  fi
  if [ -f $D/BreezeLight.colors ]; then
    sed -e 's/^Name=.*/Name=Fab Light/' -e 's/^ColorScheme=.*/ColorScheme=FabLight/' \
        -e '/^\[Colors:Window\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=245,247,253/;s/^BackgroundAlternate=.*/BackgroundAlternate=234,238,248/}' \
        -e 's/^DecorationFocus=.*/DecorationFocus=59,110,245/' -e 's/^DecorationHover=.*/DecorationHover=59,110,245/' \
        -e '/^\[Colors:Selection\]/,/^\[/{s/^BackgroundNormal=.*/BackgroundNormal=59,110,245/}' \
        -e '/^\[WM\]/,/^\[/{s/^activeBackground=.*/activeBackground=245,247,253/}' \
        $D/BreezeLight.colors > $D/FabLight.colors
  fi
  # keep the boot splash on screen until the login manager takes over (SDDM quits Plymouth itself with --retain-splash);
  # without this the console is visible for several seconds between plymouth-quit and sddm.
  systemctl mask plymouth-quit.service plymouth-quit-wait.service 2>/dev/null || true
  chmod 600 /etc/netplan/01-fabos-network-manager.yaml 2>/dev/null || true   # netplan insists on private permissions
  # Low-RAM defaults (docs/LOW-RAM.md), applied on first install only ($2 is empty) so a user's later choices survive upgrades.
  if [ -z "$2" ]; then
    # systemd-oomd (Recommends): ends the worst offender before the kernel OOM killer freezes a 2 GB machine.
    [ -f /usr/lib/systemd/system/systemd-oomd.service ] && systemctl enable systemd-oomd.service 2>/dev/null || true
    # Printing on demand: cupsd starts when something talks to /run/cups/cups.sock or a job is spooled (cups.socket/cups.path)
    # and exits after 60 s idle (IdleExitTimeout in cupsd.conf); cups-browsed (network-queue poller) is redundant with the
    # driverless discovery cupsd and the print dialog do themselves.  "systemctl disable cups" also drops its Also= units, so re-enable them.
    if [ -f /usr/lib/systemd/system/cups.service ]; then
      systemctl disable cups.service 2>/dev/null || true
      systemctl enable cups.socket cups.path 2>/dev/null || true
    fi
    [ -f /usr/lib/systemd/system/cups-browsed.service ] && systemctl disable cups-browsed.service 2>/dev/null || true
    # smartd only mails root; Fab Settings / Fab System Info already watch disk health through plasma-disks.
    [ -f /usr/lib/systemd/system/smartmontools.service ] && systemctl disable smartmontools.service 2>/dev/null || true
    # Ubuntu's MOTD news fetch (motd-news-config is not shipped and the script is not executable anyway).
    systemctl disable motd-news.timer 2>/dev/null || true
    # sysctl.d/60-fabos-lowram.conf takes effect at boot; apply now on a live system (no-op in a build container).
    [ -d /run/systemd/system ] && sysctl -q -p /etc/sysctl.d/60-fabos-lowram.conf 2>/dev/null || true
  fi
  [ -x /usr/lib/fabos/rebrand-desktop-entries ] && /usr/lib/fabos/rebrand-desktop-entries || true
;; esac
exit 0
