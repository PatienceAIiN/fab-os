[Desktop Entry]
Type=Application
Name=@DISTRO_NAME@ Updates
GenericName=Software Updates
Comment=Check for and install @DISTRO_NAME@ updates from @VENDOR_NAME@ and base system updates; choose Standard or Beta channel
Exec=fabos-updates
Icon=fabos-updates
Terminal=false
Categories=System;Settings;Qt;KDE;
Keywords=update;upgrade;channel;beta;
