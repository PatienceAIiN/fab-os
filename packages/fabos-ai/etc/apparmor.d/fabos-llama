# AppArmor profile for the @DISTRO_NAME@ built-in model server (fabos-llama.service) — ENFORCE MODE.
#
# Attached to /usr/lib/fabos/ai/llama-start.sh, the wrapper fabos-llama.service executes directly (ExecStart and
# ExecStartPost); dash, the helpers and llama-server itself inherit the profile (ix) because the unit's NoNewPrivileges=yes
# forbids later profile changes. Ubuntu's own /usr/bin/llama-server run by hand, and its (disabled) system unit, stay
# unconfined: only the Fab OS unit is covered, on purpose.
#
# Complete list of what the program touches (llama-start.sh read line by line; llama-server's data paths from ldd and
# its package contents in the image, ADR-0017):
#   reads   the GGUF model: /usr/share/fabos/models/** (built-in) or /var/lib/fabos/models/** (an administrator's own model;
#           the fabos-ai postinst creates the directory) — never anything in a home directory: a FABOS_LLAMA_MODEL pointing
#           into $HOME is refused by this profile by design (the unit then fails, `fabos-local-model status` explains)
#           /proc/meminfo, /proc/cpuinfo (context / thread sizing), /sys/devices/system/cpu/** (ggml), the ggml CPU
#           backends in /usr/lib/x86_64-linux-gnu/ggml/backends0/*.so (dlopen; covered by abstractions/base)
#   runs    dash (sh), mawk (awk), nproc, sleep, curl (ExecStartPost polls http://127.0.0.1:8081/health), kill (a dash
#           builtin: `kill -0 $MAINPID` = a signal "exists" check on llama-server), llama-server
#   network 127.0.0.1:8081 only. AppArmor 5 network rules carry no address; the address is fixed by the wrapper's
#           `--host 127.0.0.1` (asserted by tests/security-check.sh) and the unit's socket activation.
#   writes  nothing. No /tmp, no home, no cache: llama-server is started with -m <file>, --no-webui and --cache-ram (memory).

abi <abi/5.0>,

include <tunables/global>

profile fabos-llama /usr/lib/fabos/ai/llama-start.sh flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/openssl>

  network inet stream,
  network inet6 stream,
  network netlink raw,
  network unix stream,

  /usr/lib/fabos/ai/llama-start.sh r,
  /{usr/,}bin/{sh,dash,bash} ix,
  /usr/bin/{awk,mawk,gawk,curl,kill} ix,
  /etc/alternatives/awk r,
  /usr/lib/cargo/bin/coreutils/* ix,
  /usr/bin/{nproc,sleep,cat} ix,
  /usr/bin/llama-server ix,
  /usr/share/llama.cpp-tools/ r,
  /usr/share/llama.cpp-tools/** r,

  /usr/share/fabos/models/ r,
  /usr/share/fabos/models/** r,
  /var/lib/fabos/models/ r,
  /var/lib/fabos/models/** r,
  /usr/share/fabos/ai-models.json r,

  @{PROC}/meminfo r,
  @{PROC}/cpuinfo r,
  @{PROC}/@{pid}/{stat,statm,status,cmdline,cgroup,cpuset,mountinfo,mounts,maps} r,
  @{PROC}/@{pid}/task/ r,
  @{PROC}/@{pid}/task/** r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/sys/kernel/osrelease r,
  @{sys}/devices/system/cpu/** r,
  @{sys}/devices/system/node/ r,
  @{sys}/devices/system/node/** r,
  /etc/localtime r,

  # explicit, quiet denials of what the model server must never see (default-deny already covers them; listed for audit)
  deny @{HOME}/** rwlkmx,
  deny /tmp/** rwlkmx,
  deny /var/tmp/** rwlkmx,
  deny @{run}/user/@{uid}/fabos-agent/** rwlk,

  # ExecStartPost checks that the main process is alive (kill -0 = "exists"); systemd (unconfined) stops the service
  signal (send) set=(exists, term, kill) peer=fabos-llama,
  signal (receive) peer=fabos-llama,
  signal (receive) peer=unconfined,

  include if exists <local/fabos-llama>
}
