# @DISTRO_NAME@ AI defaults. Users override in ~/.config/fabos/ai.env.
# Local inference engine (Ubuntu package llama.cpp). No model is shipped;
# download one with `aios model add` and verify it: `aios model verify`.
AIOS_LLAMA_CLI=/usr/bin/llama-cli
AIOS_LLAMA_MODEL=/var/lib/fabos/models/default.gguf
