# @DISTRO_NAME@ AI defaults. Users override in ~/.config/fabos/ai.env (same keys).
#
# Local inference engine: Ubuntu package llama.cpp (llama-server, llama-cli).
# @DISTRO_NAME@ ships a built-in offline model INSIDE the image; nothing to sign up for, nothing to fetch:
#   /usr/share/fabos/models/qwen2.5-1.5b-instruct-q4_k_m.gguf   (Qwen2.5-1.5B-Instruct, Q4_K_M, Apache-2.0;
#   manifest with size + sha256: /usr/share/fabos/ai-models.json, licence: /usr/share/fabos/models/LICENSE-qwen2.5)
# It is served on demand by the user units fabos-llama.socket -> fabos-llama-proxy.service -> fabos-llama.service:
# the endpoint http://127.0.0.1:8080/v1 is always there, the model loads on the first request (about 10-20 s)
# and is unloaded after 10 minutes without a request, so it costs no RAM while idle. Needs 4 GB RAM; the units
# do not start on smaller machines (`fabos-local-model status` explains; use a cloud provider there).
#
# Point AIOS_LLAMA_MODEL / FABOS_LLAMA_MODEL at another .gguf file to serve a different local model instead.
AIOS_LLAMA_CLI=/usr/bin/llama-cli
AIOS_LLAMA_MODEL=/usr/share/fabos/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
FABOS_LLAMA_MODEL=/usr/share/fabos/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Optional tuning for fabos-llama.service (defaults are computed from /proc by /usr/lib/fabos/ai/llama-start.sh):
#FABOS_LLAMA_CTX=8192
#FABOS_LLAMA_THREADS=4
#FABOS_LLAMA_EXTRA_ARGS=
