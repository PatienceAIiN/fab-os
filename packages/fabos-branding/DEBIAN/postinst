#!/bin/sh
set -e
divert() { # divert <ubuntu-path> <our-file>
  if ! dpkg-divert --list "$1" | grep -q fabos-branding; then
    dpkg-divert --package fabos-branding --add --rename --divert "$1.ubuntu" "$1"
  fi
  ln -sfn "$2" "$1"
}
case "$1" in configure)
  divert /usr/lib/os-release       /usr/lib/fabos/os-release
  divert /etc/lsb-release          /usr/lib/fabos/lsb-release
  divert /etc/issue                /usr/lib/fabos/issue
  divert /etc/issue.net            /usr/lib/fabos/issue.net
  divert /etc/legal                /usr/lib/fabos/legal
  divert /etc/dpkg/origins/default /etc/dpkg/origins/fabos
  divert /etc/plymouth/plymouthd.conf /usr/lib/fabos/plymouthd.conf
  divert /etc/update-motd.d/00-header    /usr/lib/fabos/motd/00-header
  divert /etc/update-motd.d/10-help-text /usr/lib/fabos/motd/10-help-text
  # KDE telemetry / user-feedback KCM: hide it (reports go to Patience AI via fabos-feedback instead)
  # Also out (round 8): KDE's yearly donation-request service (already never loaded: /etc/xdg/kded6rc) and the "KWin"
  # developer runner (KWin script console commands) — both list themselves under KDE names in Background Services /
  # Fab Search's plugin page and neither is part of the product.
  for f in /usr/lib/x86_64-linux-gnu/qt6/plugins/plasma/kcms/systemsettings/kcm_feedback.so /usr/share/applications/kcm_feedback.desktop \
           /usr/lib/x86_64-linux-gnu/qt6/plugins/kf6/kded/donationmessage.so /usr/lib/x86_64-linux-gnu/qt6/plugins/kf6/krunner/krunner_kwin.so; do
    if [ -e "$f" ] && ! dpkg-divert --list "$f" | grep -q fabos-branding; then dpkg-divert --package fabos-branding --add --rename --divert "$f.disabled-by-fabos" "$f"; fi
  done
  # /etc/os-release must stay a symlink into /usr/lib
  [ -L /etc/os-release ] || ln -sfn ../usr/lib/os-release /etc/os-release
  # Ubuntu Pro / motd-news scripts are not shipped; make sure none are executable if present
  for f in /etc/update-motd.d/50-motd-news /etc/update-motd.d/91-contract-ua-esm-status /etc/update-motd.d/88-esm-announce /etc/update-motd.d/95-hwe-eol; do
    [ -e "$f" ] && chmod -x "$f" || true
  done
  # boot splash (two-step plugin, fabos.plymouth). The initramfs hook that adds Inter must be executable (build-debs.sh
  # normalises data files to 0644); then every installed kernel's initramfs is rebuilt so the new theme boots on the next start.
  chmod 755 /usr/share/initramfs-tools/hooks/fabos-plymouth-fonts 2>/dev/null || true
  update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/fabos/fabos.plymouth 200
  update-alternatives --set default.plymouth /usr/share/plymouth/themes/fabos/fabos.plymouth
  if command -v update-initramfs >/dev/null 2>&1 && ls /boot/vmlinuz-* >/dev/null 2>&1; then update-initramfs -u -k all || true; fi
  if command -v update-grub >/dev/null 2>&1 && [ -d /boot/grub ]; then update-grub || true; fi
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
  # Fab-named copies of upstream XDG data files under /usr/share/fabos (rules: /usr/lib/fabos/overrides.d; the session puts
  # that directory first in XDG_DATA_DIRS). Re-run after every apt run by /etc/apt/apt.conf.d/91fabos-rebrand-overrides.
  chmod 755 /usr/lib/fabos/rebrand-overrides 2>/dev/null || true
  [ -x /usr/lib/fabos/rebrand-overrides ] && /usr/lib/fabos/rebrand-overrides || true
;; esac
exit 0
